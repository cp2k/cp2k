&GLOBAL
  PRINT_LEVEL LOW
  PROJECT argon_idpp
  RUN_TYPE BAND
&END GLOBAL

&MOTION
  &BAND
    ALIGN_FRAMES F
    BAND_TYPE IT-NEB
    INTERPOLATION_METHOD LI_IDPP
    NPROC_REP 1
    NUMBER_OF_REPLICA 3
    ROTATE_FRAMES F
    &OPTIMIZE_BAND
      &DIIS
        MAX_STEPS 1
        NO_LS
      &END DIIS
    &END OPTIMIZE_BAND
    &PROGRAM_RUN_INFO
      INITIAL_CONFIGURATION_INFO T
    &END PROGRAM_RUN_INFO
    &REPLICA
      &COORD
        -1.5 0.0 0.0
        19.5 0.0 0.0
      &END COORD
    &END REPLICA
    &REPLICA
      &COORD
        1.5 0.0 0.0
        16.5 0.0 0.0
      &END COORD
    &END REPLICA
  &END BAND
&END MOTION

&FORCE_EVAL
  @INCLUDE 'argon_exchange.inc'
&END FORCE_EVAL
