&GLOBAL
  PRINT_LEVEL LOW
  PROJECT geo_opt_fire
  RUN_TYPE GEO_OPT
&END GLOBAL

&MOTION
  &CONSTRAINT
    &FIXED_ATOMS
      LIST 1
    &END FIXED_ATOMS
  &END CONSTRAINT
  &GEO_OPT
    MAX_FORCE 1.0E-6
    MAX_ITER 180
    OPTIMIZER FIRE
    RMS_FORCE 1.0E-6
  &END GEO_OPT
&END MOTION

@SET CELL_A 18.0
@SET PERIODIC NONE
@SET R 3.1
@INCLUDE 'fire_argon.inc'