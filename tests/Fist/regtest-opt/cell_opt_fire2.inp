&GLOBAL
  PRINT_LEVEL LOW
  PROJECT cell_opt_fire2
  RUN_TYPE CELL_OPT
&END GLOBAL

&MOTION
  &CELL_OPT
    CONSTRAINT YZ
    EXTERNAL_PRESSURE 0
    MAX_FORCE 1.0E-6
    MAX_ITER 250
    OPTIMIZER FIRE2
    PRESSURE_TOLERANCE [bar] 0.2
    RMS_FORCE 1.0E-6
  &END CELL_OPT
&END MOTION

@SET CELL_A 8.2
@SET PERIODIC X
@SET R 3.6
@INCLUDE 'fire_argon.inc'