&GLOBAL
  PROJECT uo2_rhombo_spme
  RUN_TYPE energy
&END GLOBAL

&FORCE_EVAL
  METHOD Fist
  STRESS_TENSOR analytical
  &MM
    &FORCEFIELD  # Morelon
      &CHARGE
        ATOM U
        CHARGE +3.227252
      &END CHARGE
      &CHARGE
        ATOM O
        CHARGE -1.613626
      &END CHARGE
      &NONBONDED
        &BUCK4RANGES
          A [eV] 11272.6
          ATOMS O O
          B [angstrom^-1] 1/0.1363
          C [eV*angstrom^6] 134.0
          R1 [angstrom] 1.2
          R2 [angstrom] 2.1
          R3 [angstrom] 2.6
          RCUT [angstrom] 10.4
        &END BUCK4RANGES
        &WILLIAMS
          A [eV] 566.498
          ATOMS O U
          B [angstrom^-1] 1/0.42056
          C [eV*angstrom^6] 0.0
          RCUT [angstrom] 10.4
        &END WILLIAMS
        &WILLIAMS
          A [eV] 0.0
          ATOMS U U
          B [angstrom^-1] 0.0
          C [eV*angstrom^6] 0.0
          RCUT [angstrom] 10.4
        &END WILLIAMS
      &END NONBONDED
      &SPLINE
        EMAX_ACCURACY [hartree] 0.02
        EMAX_SPLINE [hartree] 1.0E4
        EPS_SPLINE [hartree] 1.0E-7
        R0_NB [angstrom] 0.1
      &END SPLINE
    &END FORCEFIELD
    &POISSON
      &EWALD
        ALPHA [angstrom^-1] 0.35
        EWALD_TYPE spme
        GMAX 40 40 40
        &RS_GRID
          DISTRIBUTION_TYPE automatic
        &END RS_GRID
      &END EWALD
    &END POISSON
  &END MM
  &SUBSYS
    &CELL
      ! 3.8890872965 = 5.5/sqrt(2): the primitive fcc cell for a = 5.5 Angstrom
      ABC 3.8890872965 3.8890872965 3.8890872965
      ALPHA_BETA_GAMMA 60.0 60.0 60.0
    &END CELL
    &COORD
      SCALED
      U       0           0           0         UO2  1
      O       1/4         1/4         1/4       UO2  1
      O       3/4         3/4         3/4       UO2  1
    &END COORD
    &TOPOLOGY
      CONNECTIVITY user
      DISABLE_EXCLUSION_LISTS
      PARA_RES off
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
