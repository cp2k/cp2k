# Exercises DDAPC forces when some MPI ranks have no G-vectors below GCUT.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H-qmmm-ddapc-mpi
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QMMM
  &DFT
    BASIS_SET_FILE_NAME ../GTH_BASIS_SETS
    CHARGE 0
    MULTIPLICITY 2
    POTENTIAL_FILE_NAME ../POTENTIAL
    UKS
    &DENSITY_FITTING
      GCUT 0.8
      RADII 1.0
    &END DENSITY_FITTING
    &MGRID
      COMMENSURATE
      CUTOFF 50
    &END MGRID
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 20
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &MM
    &FORCEFIELD
      DO_NONBONDED FALSE
      &CHARGE
        ATOM H
        CHARGE 0.0
      &END CHARGE
    &END FORCEFIELD
    &POISSON
      &EWALD
        EWALD_TYPE NONE
      &END EWALD
    &END POISSON
  &END MM
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &QMMM
    ECOUPL GAUSS
    USE_GEEP_LIB 4
    &CELL
      ABC 2.0 7.0 8.0
      PERIODIC XYZ
    &END CELL
    &PERIODIC
      GMAX 1.0
      &MULTIPOLE ON
        EWALD_PRECISION 1.0E-6
        RCUT 8.0
      &END MULTIPOLE
    &END PERIODIC
    &QM_KIND H
      MM_INDEX 1
    &END QM_KIND
  &END QMMM
  &SUBSYS
    &CELL
      ABC 20.0 20.0 20.0
      PERIODIC XYZ
    &END CELL
    &COORD
      H 0.0 0.0 0.0
    &END COORD
    &KIND H
      BASIS_SET SZV-GTH
      POTENTIAL GTH-PADE-q1
    &END KIND
    &TOPOLOGY
      CONNECTIVITY OFF
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
