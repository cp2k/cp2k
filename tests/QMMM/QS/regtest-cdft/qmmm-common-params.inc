  # CP2K_SECTION_PATH: FORCE_EVAL
  &QMMM
    CENTER EVERY_STEP
    CENTER_GRID TRUE
    ECOUPL GAUSS
    NOCOMPATIBILITY
    USE_GEEP_LIB 4
    &CELL
      ABC 8. 8. 8.
      PERIODIC XYZ
    &END CELL
    &FORCEFIELD
      &NONBONDED
        &LENNARD-JONES
          ATOMS HW O
          EPSILON [kjmol] 0.4112256910262295
          SIGMA [nm] 0.16799667622224998
        &END LENNARD-JONES
        &LENNARD-JONES
          ATOMS HW H
          EPSILON [kjmol] 0.109904688889965
          SIGMA [nm] 0.14998267622224998
        &END LENNARD-JONES
      &END NONBONDED
    &END FORCEFIELD
    &MM_KIND HW
      RADIUS 0.440
    &END MM_KIND
    &MM_KIND OW
      RADIUS 1.20
    &END MM_KIND
    &PERIODIC
      &MULTIPOLE
        ANALYTICAL_GTERM T
        RCUT [angstrom] 3.5
      &END MULTIPOLE
      &POISSON
        PERIODIC XYZ
      &END POISSON
    &END PERIODIC
    &PRINT
      &MM_POTENTIAL
      &END MM_POTENTIAL
    &END PRINT
    &QM_KIND He
      MM_INDEX 4
    &END QM_KIND
    &QM_KIND H
      MM_INDEX 5
    &END QM_KIND
  &END QMMM
