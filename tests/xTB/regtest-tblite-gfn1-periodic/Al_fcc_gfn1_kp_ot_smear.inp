&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Al_fcc_gfn1_kp_ot_smear
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    &KPOINTS
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
      VERBOSE T
    &END KPOINTS
    &QS
      METHOD xTB
      &XTB
        GFN_TYPE TBLITE
        SCC_MIXER NONE
        &TBLITE
          METHOD GFN1
        &END TBLITE
      &END XTB
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-6
      MAX_SCF 160
      SCF_GUESS MOPAC
      &OT
        ALGORITHM STRICT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.8637824638 2.8637824638 2.8637824638
      ALPHA_BETA_GAMMA 60.0 60.0 60.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Al 0.0 0.0 0.0
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
