&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ch2o_otdiag_smear
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    &QS
      METHOD XTB
    &END QS
    &SCF
      ADDED_MOS 1
      EPS_SCF 1.0E-8
      MAX_SCF 100
      SCF_GUESS MOPAC
      &DIAGONALIZATION
        ALGORITHM OT
        &OT
          MINIMIZER DIIS
          PRECONDITIONER FULL_KINETIC
        &END OT
      &END DIAGONALIZATION
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300.0
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 20.0 20.0 20.0
      PERIODIC NONE
    &END CELL
    &COORD
      O 0.051368 0.000000 0.000000
      C 1.278612 0.000000 0.000000
      H 1.870460 0.939607 0.000000
      H 1.870460 -0.939607 0.000000
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
