&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Al_fcc_gfn2_kp_otdiag_smear
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    &KPOINTS
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
      VERBOSE T
    &END KPOINTS
    &QS
      METHOD xTB
      &XTB
        GFN_TYPE TBLITE
        SCC_MIXER TBLITE
        &TBLITE
          METHOD GFN2
        &END TBLITE
      &END XTB
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 200
      SCF_GUESS MOPAC
      &DIAGONALIZATION
        ALGORITHM OT
        EPS_ITER 1.0E-8
        MAX_ITER 120
        &OT
          ALGORITHM STRICT
          MINIMIZER LBFGS
          PRECONDITIONER FULL_SINGLE_INVERSE
          ROTATION
        &END OT
      &END DIAGONALIZATION
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 500
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.8637824638 2.8637824638 2.8637824638
      ALPHA_BETA_GAMMA 60.0 60.0 60.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Al 0.0 0.0 0.0
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
