&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Fe2_gfn2_force
  RUN_TYPE DEBUG
&END GLOBAL

&DEBUG
  CHECK_ATOM_FORCE 2 X
  DEBUG_FORCES T
  DEBUG_STRESS_TENSOR F
  DX 0.0001
  STOP_ON_MISMATCH F
&END DEBUG

&FORCE_EVAL
  &DFT
    UKS F
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD XTB
      &XTB
        CHECK_ATOMIC_CHARGES F
        GFN_TYPE TBLITE
        SCC_MIXER TBLITE
        VDW_POTENTIAL DFTD4
        &TBLITE
          ACCURACY 0.001
          METHOD GFN2
        &END TBLITE
        &TBLITE_MIXER
          DAMPING 0.05
          ITERATIONS 100
          MEMORY 100
        &END TBLITE_MIXER
      &END XTB
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-10
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR ON
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 30.0 30.0 30.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Fe 15.0 15.0 15.0
      Fe 17.0 16.3 15.7
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
