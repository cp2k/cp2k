&GLOBAL
  PREFERRED_DIAG_LIBRARY SL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME cds_flexible_sto_debug
  RUN_TYPE DEBUG
&END GLOBAL

&DEBUG
  DEBUG_FORCES T
  DEBUG_STRESS_TENSOR F
  DX 0.00005
  EPS_NO_ERROR_CHECK 0.0001
  MAX_RELATIVE_ERROR 0.75
  STOP_ON_MISMATCH F
&END DEBUG

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_ADMM_UZH
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UCL
    CHARGE 0
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &QS
      EPS_DEFAULT 1.0E-16
      METHOD XTB
      &XTB
        CHECK_ATOMIC_CHARGES F
        COULOMB_INTERACTION T
        COULOMB_LR T
        DO_EWALD F
        STO_FLEX T
        STO_NG 1
        TB3_INTERACTION T
        USE_HALOGEN_CORRECTION F
      &END XTB
    &END QS
    &SCF
      ADDED_MOS 5
      EPS_SCF 1.0E-8
      MAX_SCF 300
      SCF_GUESS MOPAC
      &MIXING
        ALPHA 0.2
        METHOD BROYDEN_MIXING
        NBUFFER 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.58961338 12.58926960 20.49509224
      ALPHA_BETA_GAMMA 90.00022179 89.99978029 120.04818165
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      CONNECTIVITY OFF
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME cds.xyz
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
