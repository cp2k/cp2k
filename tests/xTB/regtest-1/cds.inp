&GLOBAL
  PREFERRED_DIAG_LIBRARY SL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME bulk_xtb
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_ADMM_UZH
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UCL
    CHARGE 0
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &QS
      EPS_DEFAULT 1.0E-16
      METHOD XTB
      &XTB
        CHECK_ATOMIC_CHARGES F
        COULOMB_INTERACTION T
        COULOMB_LR T
        DO_EWALD F
        STO_FLEX T
        TB3_INTERACTION T
        USE_HALOGEN_CORRECTION F
      &END XTB
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 1
      SCF_GUESS RESTART
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 900
      &END OUTER_SCF
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.58961338 12.58926960 20.49509224
      ALPHA_BETA_GAMMA 90.00022179 89.99978029 120.04818165
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      CONNECTIVITY OFF
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME cds.xyz
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
