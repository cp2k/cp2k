# SSSP v2.0 PBE Efficiency NC potential, shared with the QS UPF tests.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Br2_SSSP_NC
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD SIRIUS
  &DFT
    &XC
      &XC_FUNCTIONAL
        &GGA_C_PBE
        &END GGA_C_PBE
        &GGA_X_PBE
        &END GGA_X_PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
      NDIGITS 12
    &END FORCES
  &END PRINT
  &PW_DFT
    &CONTROL
      GEN_EVP_SOLVER_NAME LAPACK
      PROCESSING_UNIT CPU
      STD_EVP_SOLVER_NAME LAPACK
      VERBOSITY 1
    &END CONTROL
    &ITERATIVE_SOLVER
      CONVERGE_BY_ENERGY 1
      ENERGY_TOLERANCE 1e-10
      NUM_STEPS 100
      TYPE DAVIDSON
    &END ITERATIVE_SOLVER
    &MIXER
      BETA 0.5
      MAX_HISTORY 8
      TYPE BROYDEN2
    &END MIXER
    &PARAMETERS
      DENSITY_TOL 1e-9
      ELECTRONIC_STRUCTURE_METHOD PSEUDOPOTENTIAL
      ENERGY_TOL 1e-11
      GK_CUTOFF 5.0
      NGRIDK 1 1 1
      NUM_DFT_ITER 100
      PW_CUTOFF 16.0
      SMEARING_WIDTH 0.001
    &END PARAMETERS
  &END PW_DFT
  &SUBSYS
    &CELL
      ABC [bohr] 10.0 10.0 10.0
    &END CELL
    &COORD
      UNIT BOHR
      Br 5.0 5.0 2.8
      Br 5.0 5.0 7.2
    &END COORD
    &KIND Br
      POTENTIAL UPF "../../QS/regtest-upf/Br.nc.pbe.z_7.oncvpsp4.spms.v1.upf"
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
