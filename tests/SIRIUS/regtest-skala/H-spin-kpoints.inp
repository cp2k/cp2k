&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H-spin-skala-sirius
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD SIRIUS
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    MULTIPLICITY 2
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS T
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_USE_CUDA F
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &PW_DFT
    &CONTROL
      GEN_EVP_SOLVER_NAME lapack
      PROCESSING_UNIT cpu
      STD_EVP_SOLVER_NAME lapack
      VERBOSITY 1
    &END CONTROL
    &ITERATIVE_SOLVER
      ENERGY_TOLERANCE 1e-9
      NUM_STEPS 100
      TYPE exact
    &END ITERATIVE_SOLVER
    &MIXER
      BETA 0.1
      MAX_HISTORY 8
      TYPE broyden2
    &END MIXER
    &PARAMETERS
      DENSITY_TOL 1e-7
      ELECTRONIC_STRUCTURE_METHOD pseudopotential
      ENERGY_TOL 1e-8
      FIXED_MAG 1.0
      GK_CUTOFF 2.6
      NGRIDK 2 1 1
      NUM_BANDS 4
      NUM_DFT_ITER 150
      NUM_MAG_DIMS 1
      PW_CUTOFF 6.0
      SHIFTK 1 0 0
      SMEARING_WIDTH 0.001
      USE_SYMMETRY F
    &END PARAMETERS
    &SKALA_GRID
      IMAGE_SHELL 1
      N_ANGULAR 110
      N_RADIAL 100
      RADIAL_SCALE 1.0
    &END SKALA_GRID
  &END PW_DFT
  &SUBSYS
    &CELL
      ABC [bohr] 6.0 6.0 6.0
    &END CELL
    &COORD
      SCALED
      H 0.30 0.40 0.30
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      MAGNETIZATION 1
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
