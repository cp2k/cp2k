&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H2-skala-sirius-spinor
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD SIRIUS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_ATOM_CHUNKS T
          NATIVE_GRID_ATOM_PARTITION SMOOTH
          NATIVE_GRID_USE_CUDA T
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PW_DFT
    &CONTROL
      GEN_EVP_SOLVER_NAME lapack
      PROCESSING_UNIT gpu
      STD_EVP_SOLVER_NAME lapack
      VERBOSITY 1
    &END CONTROL
    &ITERATIVE_SOLVER
      CONVERGE_BY_ENERGY 0
      ENERGY_TOLERANCE 1e-9
      NUM_STEPS 200
      RESIDUAL_TOLERANCE 1e-7
      SUBSPACE_SIZE 8
      TYPE davidson
    &END ITERATIVE_SOLVER
    &MIXER
      BETA 0.3
      TYPE linear
    &END MIXER
    &PARAMETERS
      DENSITY_TOL 1e-7
      ELECTRONIC_STRUCTURE_METHOD pseudopotential
      ENERGY_TOL 1e-8
      GK_CUTOFF 2.6
      NGRIDK 1 1 1
      NUM_BANDS 4
      NUM_DFT_ITER 200
      NUM_MAG_DIMS 3
      PW_CUTOFF 6.0
      SMEARING_WIDTH 0.001
      USE_SYMMETRY F
    &END PARAMETERS
    &SKALA_GRID
      N_ANGULAR 50
      N_RADIAL 30
      N_SPIN_ANGULAR 26
    &END SKALA_GRID
  &END PW_DFT
  &SUBSYS
    &CELL
      ABC [bohr] 6.0 6.0 6.0
    &END CELL
    &COORD
      SCALED
      Ha 0.30 0.40 0.30
      Hb 0.55 0.45 0.50
    &END COORD
    &KIND Ha
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT H
      POTENTIAL GTH-PBE-q1
      SIRIUS_MAGNETIZATION_VECTOR 0.2 0.0 0.0
    &END KIND
    &KIND Hb
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT H
      POTENTIAL GTH-PBE-q1
      SIRIUS_MAGNETIZATION_VECTOR 0.0 0.2 0.0
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
