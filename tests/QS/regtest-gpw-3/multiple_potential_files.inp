&GLOBAL
  PROJECT multiple_potential_files
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      CUTOFF 100
    &END MGRID
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 20
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      H_FIRST   0.0 0.0 0.0
      H_SECOND  0.7 0.0 0.0
    &END COORD
    &KIND H_FIRST
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT H
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND H_SECOND
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT H
      POTENTIAL GTH-PBE0-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
