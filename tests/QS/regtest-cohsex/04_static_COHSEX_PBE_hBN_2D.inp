&GLOBAL
  PRINT_LEVEL SILENT
  PROJECT static-COHSEX-PBE-hBN-2D
  RUN_TYPE ENERGY
  &TIMINGS
    THRESHOLD 0.01
  &END TIMINGS
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    BASIS_SET_FILE_NAME ./REGTEST_BASIS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &MGRID
      CUTOFF 100
      REL_CUTOFF 20
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-15
      EPS_PGF_ORB 1.0E-15
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-5
      MAX_SCF 100
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &DOS
        KPOINTS 2 2 1
      &END DOS
      &GW
        COHSEX QP_UPDATE
        COHSEX_SCALE_OCC 0.5
        COHSEX_SCALE_VIRT 0.5
        KPOINTS_W 4 4 1
        NUM_TIME_FREQ_POINTS 4
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC [angstrom] 2.504 2.504 15.000
      ALPHA_BETA_GAMMA 90.0 90.0 120.0
      PERIODIC XY
    &END CELL
    &COORD
      SCALED
      B  0.3333333  0.6666667  0.0
      N  0.6666667  0.3333333  0.0
    &END COORD
    &KIND B
      BASIS_SET ORB DZVP-GTH
      BASIS_SET RI_AUX RI-dummy-regtest
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND N
      BASIS_SET ORB DZVP-GTH
      BASIS_SET RI_AUX RI-dummy-regtest
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
