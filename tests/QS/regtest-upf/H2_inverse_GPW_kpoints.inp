&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H2_inverse_GPW_kpoints
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    &KPOINTS
      FULL_GRID TRUE
      KPOINT 0.17 0.09 -0.03 0.3
      KPOINT -0.23 0.02 0.11 0.7
      PARALLEL_GROUP_SIZE 0
      SCHEME GENERAL
      SYMMETRY FALSE
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 6
      REL_CUTOFF 10
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-10
      METHOD GPW
    &END QS
    &SCF
      EPS_DIIS 1.E-3
      EPS_SCF 1.E-12
      MAX_SCF 60
      &ADIIS
        VERBOSE T
      &END ADIIS
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.4
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC [bohr] 7.0 6.4 6.7
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT bohr
      H 2.0 3.0 3.0
      H 5.0 3.3 3.4
    &END COORD
    &KIND H
      BASIS_SET SZV-MOLOPT-SR-GTH-q1
      POTENTIAL UPF H.us.pbe.z_1.ld1.psl.v1.0.0-high-full-waves.upf
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
