&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT HBr_GPW
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-10
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.E-9
      MAX_SCF 60
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.4
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 6 6 6
    &END CELL
    &COORD
      H 2.1 2.7 2.0
      Br 3 3 3
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL UPF ../regtest-kind/H.pbe-hgh.UPF
    &END KIND
    &KIND Br
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q7
      POTENTIAL UPF Br.nc.pbe.z_7.oncvpsp4.spms.v1.upf
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
