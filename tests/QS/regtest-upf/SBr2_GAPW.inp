&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT SBr2_GAPW
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-10
      FORCE_PAW TRUE
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.E-9
      MAX_SCF 180
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 8 8 8
    &END CELL
    &COORD
      S 4 4 4
      Br 4 2.3 5.2
      Br 4 5.7 5.2
    &END COORD
    &KIND S
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      HARD_EXP_RADIUS 3.0
      LEBEDEV_GRID 302
      POTENTIAL UPF S.nc.pbe.z_6.oncvpsp4.spms.v1.upf
      RADIAL_GRID 200
    &END KIND
    &KIND Br
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q7
      HARD_EXP_RADIUS 3.0
      LEBEDEV_GRID 302
      POTENTIAL UPF Br.nc.pbe.z_7.oncvpsp4.spms.v1.upf
      RADIAL_GRID 200
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
