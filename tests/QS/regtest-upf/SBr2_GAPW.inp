&GLOBAL
 PROJECT SBr2_GAPW
 PRINT_LEVEL MEDIUM
 RUN_TYPE ENERGY_FORCE
&END GLOBAL
&FORCE_EVAL
 METHOD QUICKSTEP
 &DFT
  BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
  &QS
   METHOD GAPW
   FORCE_PAW TRUE
   EPS_DEFAULT 1.E-10
  &END QS
  &MGRID
   CUTOFF 600
   REL_CUTOFF 80
  &END MGRID
  &SCF
   EPS_SCF 1.E-9
   MAX_SCF 180
   SCF_GUESS ATOMIC
   &DIAGONALIZATION
   &END DIAGONALIZATION
   &MIXING
    METHOD BROYDEN_MIXING
    ALPHA 0.2
   &END MIXING
  &END SCF
  &XC
   &XC_FUNCTIONAL PBE
   &END XC_FUNCTIONAL
  &END XC
 &END DFT
 &SUBSYS
  &CELL
   ABC 10 10 10
  &END CELL
  &COORD
   S 5 5 5
   Br 5 3.3 6.2
   Br 5 6.7 6.2
  &END COORD
  &KIND S
   HARD_EXP_RADIUS 3.0
   RADIAL_GRID 200
   LEBEDEV_GRID 302
   BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
   POTENTIAL UPF S.nc.pbe.z_6.oncvpsp4.spms.v1.upf
  &END KIND
  &KIND Br
   HARD_EXP_RADIUS 3.0
   RADIAL_GRID 200
   LEBEDEV_GRID 302
   BASIS_SET DZVP-MOLOPT-PBE-GTH-q7
   POTENTIAL UPF Br.nc.pbe.z_7.oncvpsp4.spms.v1.upf
  &END KIND
 &END SUBSYS
 &PRINT
  &FORCES ON
  &END FORCES
 &END PRINT
&END FORCE_EVAL
