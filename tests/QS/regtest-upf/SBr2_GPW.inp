&GLOBAL
 PROJECT SBr2_GPW
 PRINT_LEVEL MEDIUM
 RUN_TYPE ENERGY_FORCE
&END GLOBAL
&FORCE_EVAL
 METHOD QUICKSTEP
 &DFT
  BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
  &QS
   METHOD GPW
   EPS_DEFAULT 1.E-10
  &END QS
  &MGRID
   CUTOFF 400
   REL_CUTOFF 60
  &END MGRID
  &SCF
   EPS_SCF 1.E-9
   MAX_SCF 180
   SCF_GUESS ATOMIC
   &DIAGONALIZATION
   &END DIAGONALIZATION
   &MIXING
    METHOD BROYDEN_MIXING
    ALPHA 0.2
   &END MIXING
  &END SCF
  &XC
   &XC_FUNCTIONAL PBE
   &END XC_FUNCTIONAL
  &END XC
 &END DFT
 &SUBSYS
  &CELL
   ABC 8 8 8
  &END CELL
  &COORD
   S 4 4 4
   Br 4 2.3 5.2
   Br 4 5.7 5.2
  &END COORD
  &KIND S
   BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
   POTENTIAL UPF S.nc.pbe.z_6.oncvpsp4.spms.v1.upf
  &END KIND
  &KIND Br
   BASIS_SET DZVP-MOLOPT-PBE-GTH-q7
   POTENTIAL UPF Br.nc.pbe.z_7.oncvpsp4.spms.v1.upf
  &END KIND
 &END SUBSYS
 &PRINT
  &FORCES ON
  &END FORCES
 &END PRINT
&END FORCE_EVAL
