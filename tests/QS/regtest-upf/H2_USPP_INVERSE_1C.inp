&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H2_USPP_INVERSE_1C
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
    &MGRID
      CUTOFF 6
      REL_CUTOFF 10
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-10
      METHOD GPW
      USPP_METHOD INVERSE_1C
    &END QS
    &SCF
      EPS_SCF 1.E-11
      MAX_SCF 60
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC [bohr] 7.0 6.4 6.7
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT bohr
      H 2.0 3.0 3.0
      H 5.0 3.3 3.4
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL UPF SSSP/2.0/H.us.pbe.z_1.ld1.psl.v1.0.0-high-full-waves.upf
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
