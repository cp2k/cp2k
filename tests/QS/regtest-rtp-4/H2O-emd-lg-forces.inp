&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2O-emd-lg-forces
  RUN_TYPE EHRENFEST_DYN
&END GLOBAL

&MOTION
  &MD
    ENSEMBLE NVE
    STEPS 6
    TEMPERATURE 0.0
    TIMESTEP [au_t] 0.25
  &END MD
&END MOTION

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &EFIELD
      ! Static field of 0.005 au in the length gauge, on from step 0
      ENVELOP CONSTANT
      INTENSITY 8.773600E+11
      POLARISATION 0 0.6 0.8
      WAVELENGTH [nm] 1.0E12
      &CONSTANT_ENV
        END_STEP -1
        START_STEP 0
      &END CONSTANT_ENV
    &END EFIELD
    &MGRID
      CUTOFF 200
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &REAL_TIME_PROPAGATION
      EPS_ITER 1.0E-9
      EXP_ACCURACY 1.0E-10
      INITIAL_WFN SCF_WFN
      MAT_EXP PADE
      MAX_ITER 50
      PROPAGATOR ETRS
    &END REAL_TIME_PROPAGATION
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 50
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 7 7 7
      PERIODIC NONE
    &END CELL
    &COORD
      O   0.000000    0.000000   -0.065587
      H   0.000000   -0.757136    0.520545
      H   0.000000    0.757136    0.520545
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PADE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PADE-q6
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
