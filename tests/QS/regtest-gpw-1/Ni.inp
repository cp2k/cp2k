&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Ni
  RUN_TYPE ENERGY
&END GLOBAL

! Atomic guess: eps_scf = 1.0E-06, max_iter = 200
! expected to converge in 64 steps to convergence 0.864702E-06
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &SCF
      EPS_SCF 1.0E-8
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 1
      SCF_GUESS ATOMIC
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
    &END CELL
    &COORD
      Ni     0.000000  0.000000  0.000000
    &END COORD
    &KIND Ni
      BASIS_SET DZVP-MOLOPT-SR-GTH-q18
      MAGNETIZATION 2.00
      POTENTIAL GTH-PBE-q18
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
