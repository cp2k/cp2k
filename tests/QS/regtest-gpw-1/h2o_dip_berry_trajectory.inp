&GLOBAL
  PRINT_LEVEL LOW
  PROJECT h2o_dip_berry_trajectory
  RUN_TYPE MD
&END GLOBAL

&MOTION
  &MD
    ENSEMBLE NVE
    STEPS 2
    TIMESTEP 0.5
  &END MD
  &PRINT
    &RESTART OFF
    &END RESTART
    &TRAJECTORY OFF
    &END TRAJECTORY
    &VELOCITIES OFF
    &END VELOCITIES
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 100
    &END MGRID
    &PRINT
      &MOMENTS
        FORMAT TRAJECTORY
        MAX_MOMENT 1
        PERIODIC T
        REFERENCE COAC
      &END MOMENTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      EPS_SCF 1.0E-2
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 2
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.58 10.58 10.58
    &END CELL
    &COORD
      O  0.000000  0.000000  0.119040
      H  0.000000  0.768000 -0.476160
      H  0.000000 -0.768000 -0.476160
    &END COORD
    &KIND H
      BASIS_SET ORB DZVP-GTH
      POTENTIAL GTH-PADE-q1
    &END KIND
    &KIND O
      BASIS_SET ORB DZVP-GTH
      POTENTIAL GTH-PADE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
