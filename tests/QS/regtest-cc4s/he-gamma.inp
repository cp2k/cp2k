&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT he_gamma_cc4s
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_RI_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 800
      NGRIDS 5
      REL_CUTOFF 100
    &END MGRID
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &PRINT
      &CC4S ON
        METHOD CCSD_T
        N_FROZEN_CORE 0
      &END CC4S
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_GVG_RSPACE 1.0E-12
      EPS_PGF_ORB 1.0E-12
      EPS_PPL 1.0E-12
      EPS_PPNL 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      EPS_EIGVAL 1.0E-8
      EPS_SCF 1.0E-11
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &HF
        FRACTION 1.0
        &INTERACTION_POTENTIAL
          CUTOFF_RADIUS 1.1
          POTENTIAL_TYPE TRUNCATED
        &END INTERACTION_POTENTIAL
        &RI
          RI_FLAVOR MO
          RI_METRIC HFX
          2C_MATRIX_FUNCTIONS DIAG
          EPS_EIGVAL 1.0E-12
          EPS_PGF_ORB 1.0E-12
          EPS_FILTER 1.0E-12
          EPS_FILTER_MO 1.0E-12
          EPS_FILTER_2C 1.0E-12
          EPS_STORAGE_SCALING 1.0
        &END RI
        &SCREENING
          EPS_SCHWARZ 1.0E-12
        &END SCREENING
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A [bohr] 0.0 3.7794522491301237 3.7794522491301237
      B [bohr] 3.7794522491301237 0.0 3.7794522491301237
      C [bohr] 3.7794522491301237 3.7794522491301237 0.0
      PERIODIC XYZ
    &END CELL
    &COORD
      He 0.0 0.0 0.0
    &END COORD
    &KIND He
      BASIS_SET DZVP-GTH-q2
      BASIS_SET RI_HFX RI_20_3_4_1_0_0_0_0_2.0e-07
      POTENTIAL GTH-PADE-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
