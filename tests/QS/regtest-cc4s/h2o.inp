&GLOBAL
  PRINT_LEVEL LOW
  PROJECT h2o_cc4s
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_CC4S
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
    &PRINT
      &CC4S ON
        METHOD CCSD_T
      &END CC4S
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GAPW
    &END QS
    &SCF
      EPS_EIGVAL 1.0E-8
      EPS_SCF 1.0E-11
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &HF
        FRACTION 1.0
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE COULOMB
        &END INTERACTION_POTENTIAL
        &RI
          RI_FLAVOR MO
          RI_METRIC COULOMB
          2C_MATRIX_FUNCTIONS DIAG
          EPS_EIGVAL 1.0E-12
          EPS_FILTER 1.0E-12
          EPS_FILTER_MO 1.0E-12
          EPS_FILTER_2C 1.0E-12
          EPS_STORAGE_SCALING 1.0
        &END RI
        &SCREENING
          EPS_SCHWARZ 1.0E-12
        &END SCREENING
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      O 0.0 0.0 0.117
      H 0.0 0.757 -0.468
      H 0.0 -0.757 -0.468
    &END COORD
    &KIND H
      BASIS_SET 6-31Gxx
      BASIS_SET RI_HFX cc-pVDZ-JKFIT
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET 6-31Gxx
      BASIS_SET RI_HFX cc-pVDZ-JKFIT
      POTENTIAL ALL
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
