&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Al_kpoint_otdiag
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &MGRID
      CUTOFF 120
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 60
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM OT
        EPS_ITER 1.0E-6
        MAX_ITER 100
        &OT
          ALGORITHM IRAC
          MINIMIZER DIIS
          PRECONDITIONER FULL_ALL
        &END OT
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.4
        METHOD BROYDEN_MIXING
        NBUFFER 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.8637824638 2.8637824638 2.8637824638
      ALPHA_BETA_GAMMA 60.0 60.0 60.0
    &END CELL
    &COORD
      Al 0.0 0.0 0.0
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
