&GLOBAL
  PRINT_LEVEL LOW
  PROJECT h2o_dip_slab
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 150
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC XY
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &PRINT
      &MOMENTS
        PERIODIC F
        REFERENCE ZERO
        REFERENCE_2 USER_DEFINED
        REFERENCE_POINT_2 [angstrom] 1.0 1.0 4.0
        SECOND_REFERENCE_POINT T
      &END MOMENTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      ADDED_MOS 2
      EPS_SCF 1.0E-8
      MAX_SCF 100
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 3.0 3.0 12.0
      ALPHA_BETA_GAMMA 90 90 120
      PERIODIC XY
    &END CELL
    &COORD
      O 0.1 0.1 5.0
      H 0.858 0.1 5.586
      H -0.658 0.1 5.586
    &END COORD
    &KIND O
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
