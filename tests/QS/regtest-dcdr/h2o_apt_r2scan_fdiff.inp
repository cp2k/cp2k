&GLOBAL
  PRINT_LEVEL LOW
  PROJECT h2o-apt-r2scan-fdiff
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      &OT ON
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &LINRES
      &DCDR
        APT_FD T
        &PRINT
          &APT
            FILENAME __STD_OUT__
          &END APT
        &END PRINT
      &END DCDR
    &END LINRES
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 5.0 5.0 5.0
      PERIODIC NONE
    &END CELL
    &COORD
      O  0.000000  0.000000  0.000000
      H  0.000000  0.769665 -0.591648
      H  0.000000 -0.769665 -0.591648
    &END COORD
    &KIND DEFAULT
      BASIS_SET SZV-GTH
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
