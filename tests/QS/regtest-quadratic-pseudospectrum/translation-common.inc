&GLOBAL
  PRINT_LEVEL LOW
  PROJECT quadratic-translation
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &QS
      METHOD ${QS_METHOD}
      EPS_DEFAULT 1.0E-12
    &END QS
    &MGRID
      CUTOFF 150
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &SCF
      EPS_SCF 1.0E-9
      MAX_SCF 60
      &OT
        PRECONDITIONER FULL_ALL
        MINIMIZER DIIS
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &QUADRATIC_PSEUDOSPECTRUM ON
      FORMULATION TRANSLATION
      SOLVER ${QUADRATIC_SOLVER}
      TRANSLATION_VECTOR [angstrom] 0.8 0.2 -0.1
      TRANSLATION_VECTOR [angstrom] -0.3 0.7 0.2
      WAVE_VECTOR [bohr^-1] 0.0 0.0 0.0
      WAVE_VECTOR [bohr^-1] 0.6 0.2 -0.3
      ENERGY [hartree] -0.1
      TRANSLATION_SCALE [hartree] 0.25
      NSTATES 2
      EPS_EIGEN 1.0E-10
    &END QUADRATIC_PSEUDOSPECTRUM
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 7.0 7.0 7.0
      PERIODIC NONE
    &END CELL
    &COORD
      H 3.00 3.00 3.00
      H 3.74 3.00 3.00
    &END COORD
    &KIND H
      BASIS_SET TZVP-MOLOPT-GGA-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
