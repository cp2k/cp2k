&GLOBAL
  PROJECT torus-translation
  PRINT_LEVEL LOW
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME ${POTENTIAL_FILE}
    &QS
      METHOD ${QS_METHOD}
      EPS_DEFAULT 1.0E-12
      EPS_PPNL 1.0E-14
    &END QS
    &MGRID
      CUTOFF 300
      @IF ${QS_METHOD} == GAPW
        NGRIDS 4
        REL_CUTOFF 60
      @ENDIF
      @IF ${QS_METHOD} == GPW
        NGRIDS 1
        REL_CUTOFF 40
      @ENDIF
    &END MGRID
    &POISSON
      PERIODIC ${PERIODIC}
      POISSON_SOLVER ANALYTIC
    &END POISSON
    @IF ${SCF_K} == T
      &KPOINTS
        SCHEME MONKHORST-PACK ${GRID}
        GAMMA_CENTERED T
        WAVEFUNCTIONS COMPLEX
        SYMMETRY F
      &END KPOINTS
    @ENDIF
    &SCF
      EPS_SCF 1.0E-11
      MAX_SCF 100
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &QUADRATIC_PSEUDOSPECTRUM ON
      FORMULATION TRANSLATION
      MP_GRID ${GRID}
      TRANSLATION_VECTOR [angstrom] ${SHIFT}
      WAVE_VECTOR [bohr^-1] ${WAVE}
      ENERGY [hartree] -0.1
      TRANSLATION_SCALE [hartree] 0.3
      SOC ${SOC}
      SOLVER ${QUADRATIC_SOLVER}
      NSTATES 3
      EPS_EIGEN 1.0E-10
    &END QUADRATIC_PSEUDOSPECTRUM
  &END PROPERTIES
  &SUBSYS
    &CELL
      A 4.5 0.0 0.0
      B ${B}
      C ${C}
      MULTIPLE_UNIT_CELL ${REPLICAS}
      PERIODIC ${PERIODIC}
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL ${REPLICAS}
    &END TOPOLOGY
    &COORD
      ${ELEMENT} ${CENTER}
    &END COORD
    &KIND ${ELEMENT}
      BASIS_SET TZVP-MOLOPT-GGA-GTH-q${CHARGE}
      POTENTIAL GTH-PBE-q${CHARGE}
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
