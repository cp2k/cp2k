&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ${PROJECT}
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &QS
      METHOD ${METHOD}
      EPS_DEFAULT 1.0E-12
      EPS_PPNL 1.0E-14
    &END QS
    &MGRID
      CUTOFF 300
      NGRIDS 1
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC ${PERIODIC}
      POISSON_SOLVER ANALYTIC
    &END POISSON
    @IF ${SCF_K} == T
      &KPOINTS
        SCHEME MONKHORST-PACK ${SCF_GRID}
        GAMMA_CENTERED T
        WAVEFUNCTIONS COMPLEX
        SYMMETRY ${SYMMETRY}
      &END KPOINTS
    @ENDIF
    &SCF
      EPS_SCF 1.0E-10
      MAX_SCF 80
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &QUADRATIC_PSEUDOSPECTRUM ON
      FORMULATION PERIODIC
      MP_GRID ${GRID}
      SOLVER ${SOLVER}
      SOC ${SOC}
      NSTATES 2
      EPS_EIGEN 1.0E-10
      POSITION [angstrom] ${ORIGIN}
      ENERGY [hartree] -0.1
      KAPPA [hartree*bohr^-1] 0.1
      &STATES ON
      &END STATES
    &END QUADRATIC_PSEUDOSPECTRUM
  &END PROPERTIES
  &SUBSYS
    &CELL
      A 4.5 0.0 0.0
      B 0.0 4.5 0.0
      C 0.0 0.0 4.5
      PERIODIC ${PERIODIC}
      MULTIPLE_UNIT_CELL ${SUPER_CELL}
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL ${SUPER_CELL}
    &END TOPOLOGY
    &COORD
      ${ELEMENT} 2.25 2.25 2.25
    &END COORD
    &KIND ${ELEMENT}
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q${CHARGE}
      POTENTIAL GTH-PBE-q${CHARGE}
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
