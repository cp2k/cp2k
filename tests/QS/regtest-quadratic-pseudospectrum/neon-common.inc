&GLOBAL
  PRINT_LEVEL LOW
  PROJECT quadratic-neon
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EPS_PPNL 1.0E-14
    &END QS
    &SCF
      EPS_SCF 1.0E-9
      MAX_SCF 60
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &QUADRATIC_PSEUDOSPECTRUM ON
      SOLVER ${QUADRATIC_SOLVER}
      POSITION [angstrom] 3.0 3.0 3.0
      ENERGY [hartree] -0.1
      KAPPA [hartree*bohr^-1] 0.1
      NSTATES 4
      EPS_EIGEN 1.0E-9
      SOC T
    &END QUADRATIC_PSEUDOSPECTRUM
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      Ne 3.0 3.0 3.0
    &END COORD
    &KIND Ne
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q8
      POTENTIAL GTH-PBE-q8
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
