&GLOBAL
  PRINT_LEVEL low
  PROJECT H2O-rks-diag
  RUN_TYPE DEBUG
&END GLOBAL

&DEBUG
  DEBUG_DIPOLE .FALSE.
  DEBUG_FORCES .TRUE.
  DEBUG_POLARIZABILITY .FALSE.
  DEBUG_STRESS_TENSOR .TRUE.
  DX 0.001
  MAX_RELATIVE_ERROR 0.05
  STOP_ON_MISMATCH T
&END DEBUG

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    PLUS_U_METHOD MULLIKEN_CHARGES
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &MGRID
      CUTOFF 120
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      EPS_SCF 1.0E-5
      MAX_SCF 60
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.4
        METHOD BROYDEN_MIXING
        NBUFFER 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.0 4.0 4.0
    &END CELL
    &COORD
      O  0.000   0.000   -0.111
      H  0.000  -0.744    0.495
      H  0.000   0.744    0.495
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
      &DFT_PLUS_U
        L 1
        U_MINUS_J [eV] 2.0
      &END DFT_PLUS_U
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
