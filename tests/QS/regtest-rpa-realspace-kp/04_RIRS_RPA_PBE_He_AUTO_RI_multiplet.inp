&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT periodic-he-auto-ri-multiplet
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME REGTEST_BASIS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &KPOINTS
      PARALLEL_GROUP_SIZE -1
      SCHEME MONKHORST-PACK 3 3 3
    &END KPOINTS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-9
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &WF_CORRELATION
        &RI_RS_RPA
          EPS_FILTER 1.0E-10
          NUM_TIME_FREQ_POINTS 10
          &AUTO_RI
            ! 0.5 x 6 AO functions requests 3 RI functions: one s mode and two of the three
            ! degenerate p modes. AUTO_RI keeps the whole p triplet: 4 RI functions.
            RI_AO_RATIO 0.5
          &END AUTO_RI
          &RI_RS
            TIKHONOV 1.0E-8
            &GRID_OPTIMIZATION
              CUTOFF_ATOMIC_CLUSTER [angstrom] 2.5
              MAX_ITER 20
              RS_AO_RATIO 6
            &END GRID_OPTIMIZATION
          &END RI_RS
        &END RI_RS_RPA
      &END WF_CORRELATION
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    ! One He atom on a simple cubic lattice: the cubic site symmetry makes the p-type
    ! target eigenvalues of AUTO_RI exactly threefold degenerate.
    &CELL
      ABC 2.6 2.6 2.6
      PERIODIC XYZ
    &END CELL
    &COORD
      He 0.0 0.0 0.0
    &END COORD
    &KIND He
      BASIS_SET RIRS-KP-TEST-SP
      BASIS_SET RI_AUX RI-RIRS-KP-TEST-SPD
      POTENTIAL GTH-PBE-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
