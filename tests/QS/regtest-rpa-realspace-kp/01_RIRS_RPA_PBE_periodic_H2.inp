&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT periodic-h2-rpa-k4
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME REGTEST_BASIS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &KPOINTS
      PARALLEL_GROUP_SIZE -1
      SCHEME MONKHORST-PACK 4 4 4
    &END KPOINTS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 100
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-9
      MAX_SCF 500
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.1
        BETA 1.5
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &WF_CORRELATION
        &RI_RS_RPA
          EPS_FILTER 1.0E-10
          NUM_TIME_FREQ_POINTS 20
          &AUTO_RI
            RI_AO_RATIO 3
          &END AUTO_RI
          &RI_RS
            TIKHONOV 1.0E-8
            &GRID_OPTIMIZATION
              CUTOFF_ATOMIC_CLUSTER [angstrom] 2.5
              MAX_ITER 20
              RS_AO_RATIO 6
            &END GRID_OPTIMIZATION
          &END RI_RS
        &END RI_RS_RPA
      &END WF_CORRELATION
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 3.0 3.0 3.0
      PERIODIC XYZ
    &END CELL
    &COORD
      H 3.63 4.0 4.0
      H 4.37 4.0 4.0
    &END COORD
    &KIND H
      BASIS_SET RIRS-KP-TEST
      BASIS_SET RI_AUX RI-RIRS-KP-TEST
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
