&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2O2-emd-overlap-second-deriv
  RUN_TYPE EHRENFEST_DYN
&END GLOBAL

&MOTION
  &MD
    ENSEMBLE NVE
    STEPS 1
    TIMESTEP [au_t] 0.25
  &END MD
&END MOTION

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 100
      REL_CUTOFF 20
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &REAL_TIME_PROPAGATION
      DENSITY_PROPAGATION .TRUE.
      EPS_ITER 1.0E-8
      EXP_ACCURACY 1.0E-9
      INITIAL_WFN SCF_WFN
      MAT_EXP TAYLOR
      MAX_ITER 20
      PROPAGATOR ETRS
      VELOCITY_GAUGE .TRUE.
    &END REAL_TIME_PROPAGATION
    &SCF
      EPS_SCF 1.0E-5
      MAX_SCF 64
      SCF_GUESS ATOMIC
      &OT ON
        ALGORITHM IRAC
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC [angstrom] 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      UNIT ANGSTROM
      O       6.421028       8.802562       6.594908
      O       7.782243       5.654302       7.815600
      H       6.936874       8.008755       6.736349
      H       6.601115       9.345698       7.362243
      H       8.578974       5.706451       7.287649
      H       7.835305       6.406576       8.405091
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &VELOCITY
      0.0002  0.0005 -0.0006
      -0.0007 -0.0002  0.0004
      0.0009  0.0002 -0.0004
      -0.0002  0.0008  0.0001
      0.0003 -0.0005  0.0006
      -0.0006  0.0003 -0.0008
    &END VELOCITY
  &END SUBSYS
&END FORCE_EVAL
