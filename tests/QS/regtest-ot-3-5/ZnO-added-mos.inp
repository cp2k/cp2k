&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ZnO-added-mos
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    CHARGE 0
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 1
    &END KPOINTS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-05
      MAX_SCF 25
      &OT
        ALGORITHM IRAC
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-05
        MAX_SCF 20
      &END OUTER_SCF
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 3.23735102 0.00000000 0.00000000
      B -1.61867551 2.80362822 0.00000000
      C 0.00000000 0.00000000 5.22206130
      PERIODIC XYZ
    &END CELL
    &COORD
      Zn          1.61867553    0.93454273    2.61412054
      Zn         -0.00000002    1.86908549    0.00308989
      O           1.61867553    0.93454273    4.59394289
      O          -0.00000002    1.86908549    1.98291224
    &END COORD
    &KIND Zn
      BASIS_SET SZV-MOLOPT-SR-GTH-q12
      ELEMENT Zn
      POTENTIAL GTH-PBE
    &END KIND
    &KIND O
      BASIS_SET SZV-MOLOPT-SR-GTH-q6
      ELEMENT O
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
