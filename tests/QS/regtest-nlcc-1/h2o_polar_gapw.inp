&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2O
  RUN_TYPE DEBUG
&END GLOBAL

&DEBUG
  DE 0.01
  DEBUG_DIPOLE .FALSE.
  DEBUG_FORCES .FALSE.
  DEBUG_POLARIZABILITY .TRUE.
  DEBUG_STRESS_TENSOR .FALSE.
  EPS_NO_ERROR_CHECK 5.e-4
  STOP_ON_MISMATCH T
&END DEBUG

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME NLCC_POTENTIALS
    &EFIELD
    &END EFIELD
    &MGRID
      CUTOFF 150
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &PRINT
      &MOMENTS ON
        PERIODIC .FALSE.
        REFERENCE COM
      &END MOMENTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.E-10
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.E-7
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 50
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      2ND_DERIV_ANALYTICAL .TRUE.
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &LINRES
      EPS 1E-10
      MAX_ITER 20
      PRECONDITIONER FULL_ALL
      &POLAR
        DO_RAMAN T
        PERIODIC_DIPOLE_OPERATOR F
      &END POLAR
    &END LINRES
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 7.5 7.5 7.5
      PERIODIC NONE
    &END CELL
    &COORD
      UNIT bohr
      O           0.050000       0.000000       0.225000
      H           0.100000       1.400000      -0.900000
      H           0.000000      -1.451310      -0.910000
    &END COORD
    &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-NLCC-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-NLCC-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
