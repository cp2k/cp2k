&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2O
  RUN_TYPE DEBUG
&END GLOBAL

&DEBUG
  DE 0.002
  DEBUG_DIPOLE .FALSE.
  DEBUG_FORCES .FALSE.
  DEBUG_POLARIZABILITY .TRUE.
  DEBUG_STRESS_TENSOR .FALSE.
  EPS_NO_ERROR_CHECK 5.e-5
  STOP_ON_MISMATCH T
&END DEBUG

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_ADMM
    POTENTIAL_FILE_NAME NLCC_POTENTIALS
    &AUXILIARY_DENSITY_MATRIX_METHOD
      ADMM_PURIFICATION_METHOD NONE
      EXCH_CORRECTION_FUNC PBEX
      EXCH_SCALING_MODEL NONE
      METHOD BASIS_PROJECTION
    &END AUXILIARY_DENSITY_MATRIX_METHOD
    &EFIELD
    &END EFIELD
    &MGRID
      CUTOFF 280
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &PRINT
      &MOMENTS ON
        PERIODIC .FALSE.
        REFERENCE COM
      &END MOMENTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.E-14
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.E-7
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 50
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      2ND_DERIV_ANALYTICAL .TRUE.
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &LINRES
      EPS 1E-12
      MAX_ITER 20
      PRECONDITIONER FULL_ALL
      &POLAR
        DO_RAMAN T
        PERIODIC_DIPOLE_OPERATOR F
      &END POLAR
    &END LINRES
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 7.5 7.5 7.5
      PERIODIC NONE
    &END CELL
    &COORD
      UNIT bohr
      O           0.000000       0.000000       0.224953
      H           0.000000       1.451310      -0.899812
      H           0.000000      -1.451310      -0.899812
    &END COORD
    &KIND H
      BASIS_SET DZVP-GTH
      BASIS_SET AUX_FIT cfit3
      POTENTIAL GTH-NLCC-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH
      BASIS_SET AUX_FIT cfit3
      POTENTIAL GTH-NLCC-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
