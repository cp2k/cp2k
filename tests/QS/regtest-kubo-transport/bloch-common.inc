&GLOBAL
  PRINT_LEVEL LOW
  PROJECT bloch-kubo
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &QS
      METHOD ${BLOCH_QS}
      EPS_DEFAULT 1.0E-12
      EPS_PPNL 1.0E-14
    &END QS
    &MGRID
      CUTOFF 200
      NGRIDS 1
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC ${BLOCH_PERIODIC}
      POISSON_SOLVER ${BLOCH_POISSON}
    &END POISSON
    @IF ${BLOCH_SCF_K} == T
      &KPOINTS
        SCHEME MONKHORST-PACK ${BLOCH_GRID}
        GAMMA_CENTERED T
        WAVEFUNCTIONS COMPLEX
        SYMMETRY ${BLOCH_SYMMETRY}
        INVERSION_SYMMETRY_ONLY T
      &END KPOINTS
    @ENDIF
    &SCF
      EPS_SCF 1.0E-10
      MAX_SCF 80
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    @IF ${BLOCH_PERIODIC} == XZ
      &REAL_SPACE_CHERN ON
        FORMULATION PERIODIC
        MP_GRID ${BLOCH_GRID}
        SOC ${BLOCH_SOC}
        ENERGY [hartree] -0.1
        PLANE XZ
        WINDOW_CENTER [angstrom] 2.25 3.0 4.125
        WINDOW_SIGMA [angstrom] 3.0 3.0
      &END REAL_SPACE_CHERN
    @ENDIF
    &KUBO_TRANSPORT ON
      CURRENT_OPERATOR BLOCH
      SYMMETRY ${BLOCH_PROPERTY_SYMMETRY}
      SYMMETRY_BACKEND ${BLOCH_PROPERTY_BACKEND}
      MP_GRID ${BLOCH_GRID}
      SOC ${BLOCH_SOC}
      @IF ${BLOCH_SOC} == T
        HALL_RESPONSE T
      @ENDIF
      TEMPERATURE 300
      DISSIPATION [K] 1000
      NEUTRAL_MU [hartree] -0.1
      ENERGY_RANGE [hartree] -0.1 -0.09
      N_MU 1
    &END KUBO_TRANSPORT
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC ${BLOCH_PERIODIC}
    &END CELL
    &COORD
      Ne 3.0 3.0 3.0
    &END COORD
    &KIND Ne
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q8
      POTENTIAL GTH-PBE-q8
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
