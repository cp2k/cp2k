# Expanded diamond lattice for inexpensive nonsymmorphic SOC/AO covariance checks.
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT diamond-kubo
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &KPOINTS
      GAMMA_CENTERED T
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY F
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 300
      NGRIDS 4
      REL_CUTOFF 120
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PPNL 1.0E-14
    &END QS
    &SCF
      ADDED_MOS 22
      EPS_SCF 1.0E-10
      MAX_SCF 80
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.3
        METHOD BROYDEN_MIXING
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR ON
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &KUBO_TRANSPORT ON
      CURRENT_OPERATOR BLOCH
      DISSIPATION [K] 1000
      ENERGY_RANGE [hartree] -0.1 -0.09
      HALL_RESPONSE T
      MP_GRID 2 2 2
      NEUTRAL_MU [hartree] -0.1
      N_MU 1
      SOC T
      SYMMETRY ${PROPERTY_SYMMETRY}
      SYMMETRY_BACKEND ${PROPERTY_BACKEND}
      TEMPERATURE 300
    &END KUBO_TRANSPORT
  &END PROPERTIES
  &SUBSYS
    &CELL
      A 0.0 4.0 4.0
      B 4.0 0.0 4.0
      C 4.0 4.0 0.0
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      C 0.0 0.0 0.0
      C 0.25 0.25 0.25
    &END COORD
    &KIND C
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
