&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Si_kp_lowdin_emass
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    PLUS_U_METHOD LOWDIN
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.0E-8
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      VERBOSE F
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 120
      REL_CUTOFF 30
    &END MGRID
    &PRINT
      &BAND_STRUCTURE
        &EFFECTIVE_MASS
          AUTO_EXTREMA T
          KPOINT 0.0 0.0 0.0
          KPOINT 0.25 0.25 0.25
          UNITS B_VECTOR
        &END EFFECTIVE_MASS
      &END BAND_STRUCTURE
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-10
      METHOD GPW
    &END QS
    &SCF
      EPS_EIGVAL 1.0E-10
      EPS_SCF 1.0E-7
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.50
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.43033 5.43033 5.43033
    &END CELL
    &COORD
      SCALED
      Si     0.000000    0.000000    0.000000
      Si     0.500000    0.500000    0.000000
      Si     0.500000    0.000000    0.500000
      Si     0.000000    0.500000    0.500000
      Si     0.250000    0.250000    0.250000
      Si     0.250000    0.750000    0.750000
      Si     0.750000    0.250000    0.750000
      Si     0.750000    0.750000    0.250000
    &END COORD
    &KIND Si
      BASIS_SET SZV-GTH
      POTENTIAL GTH-PADE-q4
      &DFT_PLUS_U
        L 1
        U_MINUS_J [eV] 3.0
      &END DFT_PLUS_U
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
