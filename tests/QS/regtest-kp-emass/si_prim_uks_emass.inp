&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Si_prim_uks_emass
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    LSD
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.0E-8
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 1
      SCHEME MONKHORST-PACK 3 3 3
      SYMMETRY ON
      VERBOSE F
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 120
      REL_CUTOFF 30
    &END MGRID
    &PRINT
      &BAND_STRUCTURE
        &EFFECTIVE_MASS
          AUTO_EXTREMA T
          ENERGY_WINDOW 0.01
          KPOINT 0.1 0.0 0.0
          REFINE_EXTREMA T
          UNITS CART_BOHR
        &END EFFECTIVE_MASS
      &END BAND_STRUCTURE
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-10
      METHOD GPW
    &END QS
    &SCF
      EPS_EIGVAL 1.0E-10
      EPS_SCF 1.0E-6
      MAX_SCF 30
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.70
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 0.0 2.715165 2.715165
      B 2.715165 0.0 2.715165
      C 2.715165 2.715165 0.0
      CANONICALIZE TRUE
    &END CELL
    &COORD
      SCALED
      Si     0.000000    0.000000    0.000000
      Si     0.250000    0.250000    0.250000
    &END COORD
    &KIND Si
      BASIS_SET SZV-GTH
      POTENTIAL GTH-PADE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
