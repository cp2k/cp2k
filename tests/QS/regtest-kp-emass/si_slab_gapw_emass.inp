&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Si_slab_gapw_emass
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.0E-8
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 3 3 1
      SYMMETRY OFF
      VERBOSE F
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 120
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC XY
      PSOLVER ANALYTIC
    &END POISSON
    &PRINT
      &BAND_STRUCTURE
        &EFFECTIVE_MASS
          AUTO_EXTREMA T
          BAND_INDICES 5
          EXTREMA_SEARCH_MESH 2 2 1
          KPOINT 0.25 0.0 0.0
          REFINE_EXTREMA F
          UNITS B_VECTOR
        &END EFFECTIVE_MASS
      &END BAND_STRUCTURE
    &END PRINT
    &QS
      ALPHA0_H 10.0
      EPSFIT 1.0E-4
      EPSISO 1.0E-12
      EPSRHO0 1.0E-6
      EPS_DEFAULT 1.0E-8
      LMAXN0 2
      LMAXN1 4
      METHOD GAPW_XC
    &END QS
    &SCF
      EPS_EIGVAL 1.0E-10
      EPS_SCF 1.0E-6
      MAX_SCF 30
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.70
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 3.830000 0.000000 0.000000
      B -1.915000 3.316877 0.000000
      C 0.000000 0.000000 10.000000
      PERIODIC XY
    &END CELL
    &COORD
      SCALED
      Si 0.3333333333 0.6666666667 0.464000
      Si 0.6666666667 0.3333333333 0.536000
      H  0.3333333333 0.6666666667 0.314000
      H  0.6666666667 0.3333333333 0.686000
    &END COORD
    &KIND Si
      BASIS_SET SZV-GTH
      POTENTIAL GTH-PADE-q4
    &END KIND
    &KIND H
      BASIS_SET SZV-GTH
      POTENTIAL GTH-PADE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
