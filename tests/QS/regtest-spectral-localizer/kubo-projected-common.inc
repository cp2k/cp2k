&GLOBAL
  PRINT_LEVEL LOW
  PROJECT projected-current
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    UKS ${PROJECTED_UKS}
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &QS
      METHOD ${PROJECTED_QS}
      EPS_DEFAULT 1.0E-12
    &END QS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &SCF
      EPS_SCF 1.0E-10
      MAX_SCF 60
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &KUBO_TRANSPORT ON
      CURRENT_OPERATOR PROJECTED_AO
      SOC F
      TEMPERATURE 300
      DISSIPATION [K] 1000
      NEUTRAL_MU [hartree] -0.1
      ENERGY_RANGE [hartree] -0.1 -0.09
      N_MU 1
    &END KUBO_TRANSPORT
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      H 2.63 3.0 3.0
      H 3.37 3.0 3.0
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
