&GLOBAL
  PRINT_LEVEL LOW
  PROJECT periodic-localizer
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &QS
      METHOD ${QS_METHOD}
      EPS_DEFAULT 1.0E-12
      EPS_PPNL 1.0E-14
    &END QS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC ${LOCALIZER_PLANE}
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &SCF
      EPS_SCF 1.0E-9
      MAX_SCF 60
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &SPECTRAL_LOCALIZER ON
      FORMULATION PERIODIC
      SOLVER ${LOCALIZER_SOLVER}
      INVARIANT ${LOCALIZER_INVARIANT}
      SOC T
      TIME_REVERSAL T
      PLANE ${LOCALIZER_PLANE}
      POSITION [angstrom] ${LOCALIZER_POINT}
      ENERGY [hartree] -0.1
      ETA [hartree] 0.5
    &END SPECTRAL_LOCALIZER
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC ${LOCALIZER_PLANE}
    &END CELL
    &COORD
      Ne 3.0 3.0 3.0
    &END COORD
    &KIND Ne
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q8
      POTENTIAL GTH-PBE-q8
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
