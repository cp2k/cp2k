&GLOBAL
  PROJECT H2_cdft_ci_periodic
  RUN_TYPE ENERGY
&END GLOBAL

&MULTIPLE_FORCE_EVALS
  FORCE_EVAL_ORDER 2 3
  MULTIPLE_SUBSYS FALSE
&END MULTIPLE_FORCE_EVALS

&FORCE_EVAL
  METHOD MIXED
  &MIXED
    MIXING_TYPE MIXED_CDFT
    NGROUPS 1
    &MIXED_CDFT
      CI TRUE
      COUPLING 1
      LAMBDA 1.0
    &END MIXED_CDFT
  &END MIXED
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC XYZ
    &END CELL
    &COORD
      H 3.0 3.0 2.6
      H 3.0 3.0 3.4
    &END COORD
    &KIND H
      BASIS_SET DZV-ALL-PADE
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 200
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
      GAPW_ACCURATE_XCINT TRUE
      METHOD GAPW
      &CDFT
        STRENGTH -0.110488603068
        TARGET 0.2
        TYPE_OF_CONSTRAINT BECKE
        &ATOM_GROUP
          ATOMS 1 2
          COEFF 1 -1
          CONSTRAINT_TYPE CHARGE
        &END ATOM_GROUP
        &BECKE_CONSTRAINT
          CUTOFF_TYPE GLOBAL
          GLOBAL_CUTOFF 3.2
        &END BECKE_CONSTRAINT
        &OUTER_SCF
          EPS_SCF 5.0E-3
          MAX_SCF 10
          OPTIMIZER DIIS
          TYPE CDFT_CONSTRAINT
        &END OUTER_SCF
      &END CDFT
    &END QS
    &SCF
      EPS_SCF 1.0E-5
      MAX_SCF 40
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &OUTER_SCF
        EPS_SCF 1.0E-5
        MAX_SCF 2
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
&END FORCE_EVAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 200
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
      GAPW_ACCURATE_XCINT TRUE
      METHOD GAPW
      &CDFT
        STRENGTH 0.110488603068
        TARGET -0.2
        TYPE_OF_CONSTRAINT BECKE
        &ATOM_GROUP
          ATOMS 1 2
          COEFF 1 -1
          CONSTRAINT_TYPE CHARGE
        &END ATOM_GROUP
        &BECKE_CONSTRAINT
          CUTOFF_TYPE GLOBAL
          GLOBAL_CUTOFF 3.2
        &END BECKE_CONSTRAINT
        &OUTER_SCF
          EPS_SCF 5.0E-3
          MAX_SCF 10
          OPTIMIZER DIIS
          TYPE CDFT_CONSTRAINT
        &END OUTER_SCF
      &END CDFT
    &END QS
    &SCF
      EPS_SCF 1.0E-5
      MAX_SCF 40
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &OUTER_SCF
        EPS_SCF 1.0E-5
        MAX_SCF 2
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
&END FORCE_EVAL
