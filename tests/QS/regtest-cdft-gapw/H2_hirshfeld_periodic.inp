&GLOBAL
  PROJECT H2_hirshfeld_periodic
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 100
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-10
      GAPW_ACCURATE_XCINT TRUE
      METHOD GAPW
      &CDFT
        STRENGTH 0.10
        TARGET 1.0
        TYPE_OF_CONSTRAINT HIRSHFELD
        &ATOM_GROUP
          ATOMS 1
          COEFF 1.0
          CONSTRAINT_TYPE CHARGE
        &END ATOM_GROUP
        &HIRSHFELD_CONSTRAINT
          GAUSSIAN_SHAPE COVALENT
          SHAPE_FUNCTION GAUSSIAN
        &END HIRSHFELD_CONSTRAINT
        &OUTER_SCF
          MAX_SCF 0
          OPTIMIZER BISECT
          TYPE CDFT_CONSTRAINT
        &END OUTER_SCF
      &END CDFT
    &END QS
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 80
      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 2
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
      PERIODIC XYZ
    &END CELL
    &COORD
      H 0.25 4.0 4.0
      H 7.75 4.0 4.0
    &END COORD
    &KIND H
      BASIS_SET DZV-ALL-PADE
      LEBEDEV_GRID 50
      POTENTIAL ALL
      RADIAL_GRID 50
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
