&GLOBAL
  PROJECT ${PROJECT}
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    CHARGE ${CHARGE}
    UKS TRUE
    &MGRID
      CUTOFF 100
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-10
      GAPW_ACCURATE_XCINT TRUE
      @IF ( ${CDFT_ACTIVE} == TRUE )
      &CDFT
        ATOMIC_CHARGES TRUE
        FRAGMENT_A_FILE_NAME gapw_fragment_he-TOTAL_ELECTRON_DENSITY-1_0.cube
        FRAGMENT_B_FILE_NAME gapw_fragment_h-TOTAL_ELECTRON_DENSITY-1_0.cube
        STRENGTH 0.0
        TARGET 0.0
        TYPE_OF_CONSTRAINT HIRSHFELD
        &ATOM_GROUP
          ATOMS 1
          COEFF 1.0
          FRAGMENT_CONSTRAINT
        &END ATOM_GROUP
        &DUMMY_ATOMS
          ATOMS 2
        &END DUMMY_ATOMS
        &HIRSHFELD_CONSTRAINT
          GAUSSIAN_SHAPE COVALENT
          SHAPE_FUNCTION GAUSSIAN
        &END HIRSHFELD_CONSTRAINT
        &OUTER_SCF
          MAX_SCF 0
          OPTIMIZER BISECT
          TYPE CDFT_CONSTRAINT
        &END OUTER_SCF
      &END CDFT
      @ENDIF
    &END QS
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 80
      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 2
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    @IF ( ${WRITE_CUBE} == TRUE )
    &PRINT
      &E_DENSITY_CUBE
        DENSITY_INCLUDE TOTAL_DENSITY
        STRIDE 1 1 1
      &END E_DENSITY_CUBE
    &END PRINT
    @ENDIF
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &KIND He
      BASIS_SET DZV-ALL-PADE
      LEBEDEV_GRID 50
      POTENTIAL ALL
      RADIAL_GRID 50
    &END KIND
    &KIND H
      BASIS_SET DZV-ALL-PADE
      LEBEDEV_GRID 50
      POTENTIAL ALL
      RADIAL_GRID 50
    &END KIND
    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME ${COORD_FILE}
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
