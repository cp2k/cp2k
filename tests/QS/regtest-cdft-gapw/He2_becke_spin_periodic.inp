&GLOBAL
  PROJECT He2_becke_spin_periodic
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    CHARGE 1
    MULTIPLICITY 2
    POTENTIAL_FILE_NAME POTENTIAL
    UKS TRUE
    &MGRID
      CUTOFF 100
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-10
      GAPW_ACCURATE_XCINT TRUE
      METHOD GAPW
      &CDFT
        STRENGTH 0.10 -0.05
        TARGET 0.0 0.0
        TYPE_OF_CONSTRAINT BECKE
        &ATOM_GROUP
          ATOMS 1 2
          COEFF 1.0 -1.0
          CONSTRAINT_TYPE ALPHA
        &END ATOM_GROUP
        &ATOM_GROUP
          ATOMS 1 2
          COEFF 1.0 -1.0
          CONSTRAINT_TYPE BETA
        &END ATOM_GROUP
        &BECKE_CONSTRAINT
          CUTOFF_TYPE GLOBAL
          GLOBAL_CUTOFF 100.0
        &END BECKE_CONSTRAINT
        &OUTER_SCF
          MAX_SCF 0
          OPTIMIZER BISECT
          TYPE CDFT_CONSTRAINT
        &END OUTER_SCF
      &END CDFT
    &END QS
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 80
      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 2
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
      PERIODIC XYZ
    &END CELL
    &COORD
      He 3.25 4.0 4.0
      He 4.75 4.0 4.0
    &END COORD
    &KIND He
      BASIS_SET DZV-ALL-PADE
      LEBEDEV_GRID 50
      POTENTIAL ALL
      RADIAL_GRID 50
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
