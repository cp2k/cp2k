&GLOBAL
  PRINT_LEVEL LOW
  PROJECT localizer-3d
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      METHOD ${AO_METHOD}
      EPS_DEFAULT 1.0E-12
      EPS_PPNL 1.0E-14
    &END QS
    &SCF
      EPS_SCF 1.0E-12
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &SPECTRAL_LOCALIZER ON
      DIMENSION 3
      INVARIANT Z2
      SOC T
      TIME_REVERSAL T
      ENERGY [hartree] -0.1
      POSITION [angstrom] 3.0 2.9 3.2
      KAPPA [hartree*bohr^-1] 0.1
      SPECTRAL_FLATTENING ${FLATTEN}
      EPS_GAP [hartree] ${GAP_THRESHOLD}
    &END SPECTRAL_LOCALIZER
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      Ne 2.3 2.7 3.1
      Ne 3.6 3.2 2.4
    &END COORD
    &KIND Ne
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q8
      POTENTIAL GTH-PBE-q8
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
