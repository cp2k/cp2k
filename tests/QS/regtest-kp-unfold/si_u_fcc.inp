&GLOBAL
  PRINT_LEVEL LOW
  PROJECT si_u_fcc
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &KPOINTS
      FULL_GRID ON
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &PRINT
      &BAND_STRUCTURE
        ADDED_MOS 4
        FILE_NAME si_u_fcc.bs
        &KPOINT_SET
          NPOINTS 2
          SPECIAL_POINT G 0.0 0.0 0.0
          SPECIAL_POINT X 0.5 0.0 0.5
          UNITS B_VECTOR
        &END KPOINT_SET
        &UNFOLDING
          TRANSFORMATION_MATRIX -1 1 1 1 -1 1 1 1 -1
        &END UNFOLDING
      &END BAND_STRUCTURE
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-10
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 30
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A [angstrom] 5.43 0.0 0.0
      B [angstrom] 0.0 5.43 0.0
      C [angstrom] 0.0 0.0 5.43
      PERIODIC XYZ
    &END CELL
    &COORD
      Si1 0.0000 0.0000 0.0000
      Si2 0.0000 2.7150 2.7150
      Si1 2.7150 2.7150 0.0000
      Si2 2.7150 0.0000 2.7150
      Si1 4.0725 1.3575 4.0725
      Si2 1.3575 1.3575 1.3575
      Si1 1.3575 4.0725 4.0725
      Si2 4.0725 4.0725 1.3575
    &END COORD
    &KIND Si1
      BASIS_SET SZV-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND Si2
      BASIS_SET SZV-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
    &TOPOLOGY
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
