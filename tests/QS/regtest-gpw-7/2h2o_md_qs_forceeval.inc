&FORCE_EVAL
  METHOD ${METHOD}
  &DFT
    BASIS_SET_FILE_NAME ${PATH_BASIS}
    POTENTIAL_FILE_NAME ${PATH_POTENTIAL}
    CHARGE 0
    &MGRID
      COMMENSURATE
      CUTOFF 280
    &END MGRID
    &SCF
      EPS_SCF ${EPS_SCF}
      MAX_SCF 20
      SCF_GUESS ${SCF_GUESS}
      &OT T
        #MINIMIZER        CG
        #LINESEARCH       3PNT
        #LINESEARCH       GOLD
        MINIMIZER DIIS
        N_DIIS 7
        PRECONDITIONER FULL_ALL
        #ROTATION
      &END OT
      &OUTER_SCF
        EPS_SCF 5.0E-7
        MAX_SCF 20
      &END OUTER_SCF
      &PRINT SILENT
        &PROGRAM_RUN_INFO SILENT
        &END PROGRAM_RUN_INFO
      &END PRINT
    &END SCF
    &QS
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION PS
      EXTRAPOLATION_ORDER 3
    &END QS
    &XC
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
        &PAIR_POTENTIAL
          REFERENCE_FUNCTIONAL ${DFT}
          TYPE DFTD2
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
      &XC_FUNCTIONAL ${DFT}
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_DERIV SPLINE2_SMOOTH
        XC_SMOOTH_RHO NN10
      &END XC_GRID
    &END XC
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
      &MT
        ALPHA 7.0
        REL_CUTOFF 2.0
      &END MT
    &END POISSON
    @IF ${WAN}==T
    &LOCALIZE T
      METHOD CRAZY
    &END LOCALIZE
    &PRINT
      &LOCALIZATION
        &MOLECULAR_DIPOLES
          FILENAME =${BASE_NAME}-${ID}.moldip
          REFERENCE ZERO
          &EACH
            GEO_OPT 1
          &END EACH
        &END MOLECULAR_DIPOLES
        &TOTAL_DIPOLE
          FILENAME =${BASE_NAME}-${ID}.dip
          REFERENCE ZERO
          &EACH
            GEO_OPT 1
          &END EACH
        &END TOTAL_DIPOLE
        &WANNIER_CENTERS
          FILENAME =${BASE_NAME}-${ID}_wan.xyz
          IONS+CENTERS T
          &EACH
            MD 2
          &END EACH
        &END WANNIER_CENTERS
      &END LOCALIZATION
    &END PRINT
    @ENDIF
    &PRINT
      &MOMENTS
        FILENAME =${BASE_NAME}-${ID}.dipole
        MAX_MOMENT 1
        PERIODIC F
        REFERENCE COM
        &EACH
          MD 1
        &END EACH
      &END MOMENTS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.0 5.0 5.0
      PERIODIC NONE
    &END CELL
    &COORD
      H     0.000000     0.000000     0.000000
      H     0.000000     0.000000     0.780000
    &END COORD
    &KIND O
      BASIS_SET TZV2P-GTH
      POTENTIAL GTH-${DFT}-q6
    &END KIND
    &KIND H
      BASIS_SET TZV2P-GTH
      POTENTIAL GTH-${DFT}-q1
    &END KIND
    &VELOCITY
      2.3618058285504007E-05    1.1208686661557631E-04   -1.9047367705860110E-05
      5.0344761330951013E-04    2.0833711996145576E-04    8.0587494601059521E-04
    &END VELOCITY
  &END SUBSYS
&END FORCE_EVAL
