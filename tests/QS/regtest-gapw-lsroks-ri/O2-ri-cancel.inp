! Compact O2 implementation regression: EPS_SCF 0.1 tests several orbital updates.
! This coarse trajectory is not a converged molecular reference.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT O2-ri-cancel
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_RI_cc-TZ
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    ROKS
    &LOW_SPIN_ROKS
      ENERGY_SCALING -1 1
      SPIN_CONFIGURATION 1 2
      SPIN_CONFIGURATION 1 2
    &END LOW_SPIN_ROKS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 50
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      EPSFIT 1e-4
      EPS_DEFAULT 1e-12
      EPS_GVG_RSPACE 1e-10
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 0.1
      MAX_SCF 20
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
      &PRINT
        &RESTART
          BACKUP_COPIES 0
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &HF
        &MEMORY
          MAX_MEMORY 128
        &END MEMORY
        &RI
        &END RI
        &SCREENING
          EPS_SCHWARZ 1e-12
        &END SCREENING
      &END HF
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4 4 6
      PERIODIC NONE
    &END CELL
    &COORD
      O 2 2 2.392
      O 2 2 3.608
    &END COORD
    &KIND O
      BASIS_SET 6-31G*
      BASIS_SET RI_HFX RI_DZ
      LEBEDEV_GRID 110
      POTENTIAL ALL
      RADIAL_GRID 60
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
