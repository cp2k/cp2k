&GLOBAL
  PRINT_LEVEL LOW
  PROJECT hall-current
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &QS
      METHOD ${HALL_QS}
      EPS_DEFAULT 1.0E-12
      EPS_PPNL 1.0E-14
    &END QS
    &MGRID
      CUTOFF 200
      NGRIDS 1
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC ${HALL_PERIODIC}
      POISSON_SOLVER ${HALL_POISSON}
    &END POISSON
    @IF ${HALL_BLOCH} == T
      &KPOINTS
        SCHEME MONKHORST-PACK ${HALL_GRID}
        GAMMA_CENTERED T
        WAVEFUNCTIONS COMPLEX
        SYMMETRY T
        INVERSION_SYMMETRY_ONLY T
      &END KPOINTS
    @ENDIF
    &SCF
      EPS_SCF 1.0E-10
      MAX_SCF 80
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    @IF ${HALL_BLOCH} == F
      &REAL_SPACE_CHERN ON
        SOC T
        ENERGY [hartree] -0.1
        PLANE YX
        WINDOW_CENTER [angstrom] 3.1 2.8 3.0
        WINDOW_SIGMA [bohr] 1.2 1.7
      &END REAL_SPACE_CHERN
    @ENDIF
    &KUBO_TRANSPORT ON
      CURRENT_OPERATOR ${HALL_CURRENT}
      HALL_RESPONSE T
      SOC T
      SYMMETRY ${HALL_SYMMETRY}
      SYMMETRY_BACKEND ${HALL_BACKEND}
      @IF ${HALL_BLOCH} == T
        MP_GRID ${HALL_GRID}
      @ENDIF
      TEMPERATURE 300
      DISSIPATION [K] 1000
      NEUTRAL_MU [hartree] -0.1
      ENERGY_RANGE [hartree] -0.1 -0.09
      N_MU 1
    &END KUBO_TRANSPORT
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC ${HALL_PERIODIC}
    &END CELL
    &COORD
      Ne 3.0 3.0 3.0
    &END COORD
    &KIND Ne
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q8
      POTENTIAL GTH-PBE-q8
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
