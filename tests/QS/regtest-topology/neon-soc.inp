&GLOBAL
  PRINT_LEVEL LOW
  PROJECT neon
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &KPOINTS
      FULL_GRID T
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY F
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &PRINT
      &WANNIER90 ON
        EXCLUDE_BANDS 9 10
        KPOINTS_SOURCE WILSON
        SEED_NAME neon
        SOC T
        TIME_REVERSAL T
        WILSON_MAX_REFINEMENT 2
        WILSON_MESH 4 3
        Z2 T
      &END WANNIER90
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-14
      EPS_PPNL 1.0E-14
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 1
      EPS_SCF 1.0E-9
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.4
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.0 5.0 5.0
    &END CELL
    &COORD
      SCALED
      Ne 0.5 0.5 0.5
    &END COORD
    &KIND Ne
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q8
      POTENTIAL GTH-PBE-q8
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
