! RTP from the SCF orbitals, localized by LOCALIZE_INITIAL_WFN before a periodic delta kick:
! the density, hence the energy, is the same as when starting from the canonical orbitals
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2O-loc-wfn-3
  RUN_TYPE RT_PROPAGATION
&END GLOBAL

&MOTION
  &MD
    STEPS 3
    TIMESTEP [au_t] 0.2
  &END MD
&END MOTION

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &LOCALIZE
      EPS_LOCALIZATION 1.0E-10
      METHOD JACOBI
    &END LOCALIZE
    &MGRID
      CUTOFF 150
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &REAL_TIME_PROPAGATION
      APPLY_DELTA_PULSE
      DELTA_PULSE_DIRECTION 1 1 0
      DELTA_PULSE_SCALE 0.001
      EPS_ITER 1.0E-9
      EXP_ACCURACY 1.0E-10
      INITIAL_WFN SCF_WFN
      LOCALIZE_INITIAL_WFN
      MAT_EXP ARNOLDI
      MAX_ITER 20
      PERIODIC .TRUE.
      PROPAGATOR ETRS
    &END REAL_TIME_PROPAGATION
    &SCF
      ADDED_MOS 2
      EPS_SCF 1.0E-8
      MAX_SCF 50
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
    &END SCF
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.0 5.0 5.0
    &END CELL
    &COORD
      O   0.000000    0.000000   -0.065587 H2O
      H   0.000000   -0.757136    0.520545 H2O
      H   0.000000    0.757136    0.520545 H2O
    &END COORD
    &KIND H
      BASIS_SET DZVP-GTH-BLYP
      POTENTIAL GTH-BLYP-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH-BLYP
      POTENTIAL GTH-BLYP-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
