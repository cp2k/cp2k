# Report-only mode ("&ELECTRONS F") with k-points: Gamma-only k-point scheme with complex wavefunctions,
# OT with ADDED_MOS and smearing. The Fermi level is read off the k-point MO sets, the work function
# off the planar-averaged Hartree potential, and both are logged to the .cpcont file every step.
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT cp-kpoint-report-only
  RUN_TYPE MD
  SEED 1234
&END GLOBAL

&MOTION
  &MD
    ENSEMBLE NVE
    STEPS 1
    TEMPERATURE 300.0
    TIMESTEP 0.5
    &ELECTRONS F
      POTENTIAL_AVERAGE_AXIS Z
      POTENTIAL_AVERAGE_REGION 10.0 14.0
    &END ELECTRONS
  &END MD
&END MOTION

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR NONE
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &KPOINTS
      SCHEME GAMMA
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 150
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      ADDED_MOS 8
      EPS_SCF 1.0E-5
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &OT
        ENERGIES
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-5
        MAX_SCF 10
      &END OUTER_SCF
      &SMEAR
        ELECTRONIC_TEMPERATURE 300.0
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.05 4.05 20.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Al   0.000   0.000   0.000
      Al   2.025   2.025   0.000
      Al   2.025   0.000   2.025
      Al   0.000   2.025   2.025
    &END COORD
    &KIND Al
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
