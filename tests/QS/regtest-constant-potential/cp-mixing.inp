# Constant-potential MD with dual integer-endpoint charge mixing on a small Al(111) slab.
# Two QS force evals (CHARGE +1 -> 11 e, CHARGE 0 -> 12 e) are linearly combined by a MIXED
# force eval; the electron count q = 11.5 gives the mixing weight 0.5. Three NVT steps.
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT cp-mixing
  RUN_TYPE MD
  SEED 1234
&END GLOBAL

&MOTION
  &CONSTRAINT
    &FIXED_ATOMS
      LIST 1 2
    &END FIXED_ATOMS
  &END CONSTRAINT
  &MD
    ENSEMBLE NVT
    STEPS 1
    TEMPERATURE 300.0
    TIMESTEP 0.5
    &ELECTRONS T
      CHARGE_MIXING T
      CHARGE_MIXING_SPAN 1
      MASS 400.0
      NEUTRAL_ELECTRONS 12.0
      POTENTIAL_AVERAGE_AXIS Z
      POTENTIAL_AVERAGE_REGION 8.0 11.0
      Q_INIT 11.5
      TARGET_WORKFUNCTION 4.0
      TAU_POTENTIOSTAT 200.0
      TEMP_POTENTIOSTAT 300.0
    &END ELECTRONS
    &THERMOSTAT
      TYPE CSVR
      &CSVR
        TIMECON 200.0
      &END CSVR
    &END THERMOSTAT
  &END MD
&END MOTION

&MULTIPLE_FORCE_EVALS
  FORCE_EVAL_ORDER 1 2
  MULTIPLE_SUBSYS F
&END MULTIPLE_FORCE_EVALS

# Endpoint N_lo = 11 electrons
&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR NONE
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    CHARGE 1
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS
    &MGRID
      CUTOFF 100
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      ADDED_MOS 4
      EPS_SCF 1.0E-5
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.1
        BETA 1.5
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR ON
        ELECTRONIC_TEMPERATURE [K] 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          TYPE DFTD3(BJ)
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.864 4.9605 14.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Al   0.000   0.0000  1.000
      Al   1.432   2.4803  1.000
      Al   1.432   0.8268  3.338
      Al   0.000   3.3070  3.338
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH-q3
      POTENTIAL GTH-PBE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

# Endpoint N_hi = 12 electrons
&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR NONE
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    CHARGE 0
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS
    &MGRID
      CUTOFF 100
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      ADDED_MOS 4
      EPS_SCF 1.0E-5
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.1
        BETA 1.5
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR ON
        ELECTRONIC_TEMPERATURE [K] 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          TYPE DFTD3(BJ)
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.864 4.9605 14.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Al   0.000   0.0000  1.000
      Al   1.432   2.4803  1.000
      Al   1.432   0.8268  3.338
      Al   0.000   3.3070  3.338
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH-q3
      POTENTIAL GTH-PBE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

# Parent MIXED force eval (not listed in FORCE_EVAL_ORDER)
&FORCE_EVAL
  METHOD MIXED
  &MIXED
    MIXING_TYPE LINEAR_COMBINATION
    NGROUPS 1
    &LINEAR
      LAMBDA 0.5
    &END LINEAR
  &END MIXED
  &SUBSYS
    &CELL
      ABC 2.864 4.9605 14.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Al   0.000   0.0000  1.000
      Al   1.432   2.4803  1.000
      Al   1.432   0.8268  3.338
      Al   0.000   3.3070  3.338
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH-q3
      POTENTIAL GTH-PBE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
