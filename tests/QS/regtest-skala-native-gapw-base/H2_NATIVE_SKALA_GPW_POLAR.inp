&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2_SKALA_POLAR
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &EFIELD
    &END EFIELD
    &MGRID
      CUTOFF 40
      REL_CUTOFF 10
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &PRINT
      &MOMENTS ON
        PERIODIC F
        REFERENCE COM
      &END MOMENTS
    &END PRINT
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      EPS_SCF 1.0E-11
      MAX_SCF 100
      &OT
        PRECONDITIONER FULL_SINGLE_INVERSE
        MINIMIZER DIIS
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_MODEL_FP64 T
          NATIVE_GRID_ATOM_PARTITION SMOOTH
          NATIVE_GRID_LAYOUT COMMON_GRID
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &LINRES
      EPS 1.0E-12
      MAX_ITER 100
      PRECONDITIONER FULL_ALL
      &POLAR
        DO_RAMAN T
        PERIODIC_DIPOLE_OPERATOR F
      &END POLAR
    &END LINRES
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 4.0 4.0 4.0
      PERIODIC NONE
    &END CELL
    &COORD
      H 2.0 2.0 1.65
      H 2.0 2.0 2.35
    &END COORD
    &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
