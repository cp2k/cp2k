&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT periodic-h2-ae-gw
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_RI_AUG_MOLOPT_ae
    POTENTIAL_FILE_NAME ALL_POTENTIALS
    SORT_BASIS EXP
    &KPOINTS
      PARALLEL_GROUP_SIZE -1
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &MGRID
      CUTOFF 100
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-10
      EPS_PGF_ORB 1.0E-10
      METHOD GAPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-6
      MAX_SCF 500
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.4
        BETA 1.5
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &BANDSTRUCTURE_PATH
        NPOINTS 2
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT X 0 0.5 0.5
      &END BANDSTRUCTURE_PATH
      &GW
        EPS_FILTER 1.0E-10
        FREQ_MAX_FIT 27.211
        NUM_TIME_FREQ_POINTS 10
        &RI_RS
          GRID_SELECT 2
          TIKHONOV 1.0E-8
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC XYZ
    &END CELL
    &COORD
      H 2.63 3.0 3.0
      H 3.37 3.0 3.0
    &END COORD
    &KIND H
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_009_s_p_d_f_g_h_i_3_2_0_0_0_0_0_error_4.4e-05
      POTENTIAL ALL
      &BASIS ORB
        2
        2 0 0 4 2
        0.1119200649 0.0912230399 0.9812902240
        0.3749477190 0.8272484291 0.0201024169
        1.4466857212 0.5468013574 -0.1892389601
        12.2488548993 0.0913601066 -0.0292233654
        2 1 1 4 2
        0.1119200649  0.0998895850  3.1905343582
        0.3749477190  0.8564017401  0.4114908553
        1.4466857212  0.5056746863  0.0950521878
        12.2488548993 -0.0298536766  0.0000000000
      &END BASIS
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
