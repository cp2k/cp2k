@SET seed li_both
@SET kpoints T
@SET source SCF
@SET reuse T
@SET spin BOTH
# Reuse the k-point SCF for the subsequent spin-selection/export variants.
@SET scf_guess RESTART
@SET write_restart OFF
@IF ( ${seed} == li_both )
@SET scf_guess ATOMIC
@SET write_restart ON
@ENDIF
@IF ( ${kpoints} == F )
@SET scf_guess ATOMIC
@ENDIF
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ${seed}
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    WFN_RESTART_FILE_NAME li-RESTART.wfn
    UKS T
    MULTIPLICITY 2
    @IF ( ${kpoints} == T )
    &KPOINTS
      EPS_SYMMETRY 1.e-8
      GAMMA_CENTERED T
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      SYMMETRY_BACKEND K290
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    @ENDIF
    &MGRID
      CUTOFF 200
      REL_CUTOFF 30
    &END MGRID
    &PRINT
      &WANNIER90 ON
        INITIAL_PROJECTIONS AO_SCDM
        KPOINTS_SOURCE ${source}
        MP_GRID 2 2 2
        REUSE_SCF_MOS ${reuse}
        SEED_NAME ${seed}
        SPIN_CHANNEL ${spin}
        USE_BLOCH_PHASES T
        VALIDATE_REUSE_SCF_MOS T
        WANNIER_FUNCTIONS 2
        WANNIER_FUNCTIONS 1
      &END WANNIER90
    &END PRINT
    &QS
      EPS_DEFAULT 1.e-12
      METHOD GPW
    &END QS
    &SCF
      CHOLESKY OFF
      EPS_EIGVAL 1.e-9
      EPS_SCF 1.e-12
      @IF ( ${kpoints} == F )
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      @ENDIF
      MAX_SCF 300
      SCF_GUESS ${scf_guess}
      @IF ( ${kpoints} == T )
      &MIXING
        ALPHA 0.5
        METHOD BROYDEN_MIXING
        # Retain enough history to avoid a long convergence tail at EPS_SCF 1.e-12.
        NBUFFER 16
      &END MIXING
      @ENDIF
      &PRINT
        &RESTART ${write_restart}
          BACKUP_COPIES 0
          FILENAME =li-RESTART.wfn
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      SCALED
      Li 0.5 0.5 0.5
    &END COORD
    &KIND Li
      BASIS_SET ORB DZVP-MOLOPT-GGA-GTH-q3
      POTENTIAL GTH-GGA-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
