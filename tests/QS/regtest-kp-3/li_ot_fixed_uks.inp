&GLOBAL
  PRINT_LEVEL LOW
  PROJECT li_ot_fixed_uks
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    MULTIPLICITY 2
    POTENTIAL_FILE_NAME POTENTIAL
    UKS T
    &KPOINTS
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      VERBOSE T
    &END KPOINTS
    &MGRID
      CUTOFF 80
      REL_CUTOFF 20
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      EPS_SCF 1.0E-4
      MAX_SCF 20
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM IRAC
        MINIMIZER CG
        PRECONDITIONER FULL_KINETIC
      &END OT
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      SCALED
      Li 0.5 0.5 0.5
    &END COORD
    &KIND Li
      BASIS_SET SZV-GTH
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
