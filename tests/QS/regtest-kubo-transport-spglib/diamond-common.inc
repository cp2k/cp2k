&GLOBAL
  PRINT_LEVEL LOW
  PROJECT diamond-kubo
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PPNL 1.0E-14
    &END QS
    &MGRID
      CUTOFF 300
      NGRIDS 4
      REL_CUTOFF 120
    &END MGRID
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
      GAMMA_CENTERED T
      WAVEFUNCTIONS COMPLEX
      SYMMETRY F
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-10
      MAX_SCF 80
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &KUBO_TRANSPORT ON
      CURRENT_OPERATOR BLOCH
      MP_GRID 2 2 2
      SYMMETRY ${PROPERTY_SYMMETRY}
      SYMMETRY_BACKEND ${PROPERTY_BACKEND}
      SOC T
      TEMPERATURE 300
      DISSIPATION [K] 1000
      NEUTRAL_MU [hartree] -0.1
      ENERGY_RANGE [hartree] -0.1 -0.09
      N_MU 1
    &END KUBO_TRANSPORT
  &END PROPERTIES
  &SUBSYS
    &CELL
      A 0.0 1.7835 1.7835
      B 1.7835 0.0 1.7835
      C 1.7835 1.7835 0.0
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      C 0.0 0.0 0.0
      C 0.25 0.25 0.25
    &END COORD
    &KIND C
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
