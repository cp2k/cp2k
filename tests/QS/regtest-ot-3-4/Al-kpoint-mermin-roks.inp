&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Al_kpoint_mermin_roks
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    MULTIPLICITY 2
    POTENTIAL_FILE_NAME POTENTIAL
    ROKS
    &KPOINTS
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 1 1
      SYMMETRY ON
      VERBOSE T
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-4
      MAX_SCF 400
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_S_INVERSE
        ROTATION
      &END OT
      &PRINT
        &RESTART ON
          BACKUP_COPIES 0
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 5000
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.8637824638 2.8637824638 2.8637824638
      ALPHA_BETA_GAMMA 60.0 60.0 60.0
    &END CELL
    &COORD
      Al 0.0 0.0 0.0
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
