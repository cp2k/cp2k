&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Al_kpoint_mermin_uks_fixed_moment
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    UKS TRUE
    &KPOINTS
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-7
      MAX_SCF 80
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM STRICT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER LBFGS
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 1000
        FIXED_MAGNETIC_MOMENT 1.0
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.8637824638 2.8637824638 2.8637824638
      ALPHA_BETA_GAMMA 60.0 60.0 60.0
    &END CELL
    &COORD
      Al 0.0 0.0 0.0
    &END COORD
    &KIND Al
      BASIS_SET SZV-MOLOPT-SR-GTH-q3
      MAGNETIZATION 1.0
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
