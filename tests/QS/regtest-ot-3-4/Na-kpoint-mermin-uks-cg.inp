&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Na_kpoint_mermin_uks_cg
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    UKS TRUE
    &KPOINTS
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS 1
      EPS_SCF 5.0E-7
      MAX_SCF 30
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_KINETIC
        ROTATION
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 3.662 3.662 3.662
      ALPHA_BETA_GAMMA 109.4712206 109.4712206 109.4712206
    &END CELL
    &COORD
      Na 0.0 0.0 0.0
    &END COORD
    &KIND Na
      BASIS_SET SZV-GTH-PADE
      MAGNETIZATION 1
      POTENTIAL GTH-PADE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
