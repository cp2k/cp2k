&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H2O_aics_fd
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 40
      NGRIDS 4
      &RS_GRID
        DISTRIBUTION_TYPE DISTRIBUTED
      &END RS_GRID
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCCS ON
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD FFT
      DIELECTRIC_CONSTANT 78.36
      EPS_SCCS 1.0E-3
      EPS_SCF 1.0E6
      GAMMA [mN/m] 0.0
      MAX_ITER 100
      METHOD ANDREUSSI
      MIXING 0.6
      &AICS ON
        ALPHA 0.5 0.5
        BETA 2.0 2.0
        D0 6.0 7.5
        EPSILON_DIST_NEAR 78.36 2.0
        INTERFACE_PLANE AB
        LOWER_SURFACE_ATOMS 3
        POISSON_SOLVER FINITE_DIFFERENCE
        SIGMA 1.5 2.5
        ! Compact numerical regression only, not physical electrode validation; global atom indices.
        UPPER_SURFACE_ATOMS 2
      &END AICS
      &ANDREUSSI
        RHO_MAX 0.001
        RHO_MIN 0.0001
      &END ANDREUSSI
    &END SCCS
    &SCF
      EPS_SCF 1.0E-3
      IGNORE_CONVERGENCE_FAILURE TRUE
      MAX_SCF 2
      SCF_GUESS ATOMIC
      &MIXING ON
        ALPHA 0.2
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
    &END CELL
    &COORD
      O  4.9999870401  4.5606769781  4.5606769833
      H  5.0000000491  4.4536015938  5.5327585878
      H  5.0000000214  5.5327585972  4.4536017371
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
