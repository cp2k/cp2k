&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT hbn-2d-auto-ri-gpw-k2
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    AUTO_BASIS RI_AUX LARGE
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &KPOINTS
      PARALLEL_GROUP_SIZE -1
      SCHEME MONKHORST-PACK 2 2 1
    &END KPOINTS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 100
    &END MGRID
    &POISSON
      PERIODIC XY
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-9
      MAX_SCF 500
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.1
        BETA 1.5
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &BANDSTRUCTURE_PATH
        NPOINTS 2
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT K 0.3333333333333333 0.3333333333333333 0
      &END BANDSTRUCTURE_PATH
      &GW
        EPS_FILTER 1.0E-10
        FREQ_MAX_FIT 27.211
        NUM_TIME_FREQ_POINTS 32
        REGULARIZATION_RI -1
        &AUTO_RI
          RI_AO_RATIO 3
        &END AUTO_RI
        &RI_RS
          TIKHONOV 1.0E-8
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 2.5
            MAX_ITER 20
            RS_AO_RATIO 6
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 2.5 2.5 15.0
      ALPHA_BETA_GAMMA 90 90 120
      PERIODIC XY
    &END CELL
    &COORD
      B 0.0 0.0 7.5
      N 1.25 0.7216878364870322 7.5
    &END COORD
    &KIND B
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND N
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
