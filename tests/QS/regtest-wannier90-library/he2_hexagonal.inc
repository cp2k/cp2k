&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ${project}
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &KPOINTS
      EPS_SYMMETRY 1.e-8
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      GAMMA_CENTERED T
      SYMMETRY ON
      SYMMETRY_BACKEND ${backend}
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 1000
      REL_CUTOFF 100
    &END MGRID
    &PRINT
      &WANNIER90 ON
        KPOINTS_SOURCE SCF
        REUSE_SCF_MOS ${reuse}
        VALIDATE_REUSE_SCF_MOS ${reuse}
        SEED_NAME ${project}
        USE_BLOCH_PHASES T
        WANNIER_FUNCTIONS 2
        &LIBRARY ON
          CONV_TOL 1.e-10
          NUM_ITER 1000
        &END LIBRARY
      &END WANNIER90
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      CHOLESKY OFF
      EPS_EIGVAL 1.e-12
      EPS_SCF 1.0E-12
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.70
        METHOD BROYDEN_MIXING
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.0 4.0 6.4
      ALPHA_BETA_GAMMA 90 90 120
    &END CELL
    &COORD
      SCALED
      He    0.3333333333333333    0.6666666666666667    0.25
      He    0.6666666666666667    0.3333333333333333    0.75
    &END COORD
    &KIND He
      BASIS_SET ORB DZVP-MOLOPT-GGA-GTH-q2
      POTENTIAL GTH-GGA-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
