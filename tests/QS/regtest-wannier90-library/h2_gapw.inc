&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ${seed}
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
      GAMMA_CENTERED T
      PARALLEL_GROUP_SIZE 0
      SYMMETRY ON
      SYMMETRY_BACKEND K290
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &PRINT
      &WANNIER90 ON
        SEED_NAME ${seed}
        KPOINTS_SOURCE ${source}
        MP_GRID 2 2 2
        REUSE_SCF_MOS ${reuse}
        VALIDATE_REUSE_SCF_MOS T
        WANNIER_FUNCTIONS 1
        USE_BLOCH_PHASES T
        &LIBRARY ON
          INITIAL_PROJECTIONS AUTO
          WRITE_INPUTS T
          WRITE_HR T
          WRITE_U_MATRICES T
          NUM_ITER 1000
          CONV_WINDOW 5
          CONV_TOL 1.e-10
        &END LIBRARY
      &END WANNIER90
    &END PRINT
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.e-12
    &END QS
    &SCF
      CHOLESKY OFF
      EPS_EIGVAL 1.e-12
      EPS_SCF 1.e-10
      MAX_SCF 200
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.3
        METHOD BROYDEN_MIXING
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.0 5.0 5.0
    &END CELL
    &COORD
      SCALED
      H 0.5 0.5 0.425
      H 0.5 0.5 0.575
    &END COORD
    &KIND H
      BASIS_SET TZVPP-MOLOPT-GGA-ae
      POTENTIAL ALL
      LEBEDEV_GRID 50
      RADIAL_GRID 80
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
