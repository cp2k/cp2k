&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ch2_roks_fcidump
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    MULTIPLICITY 3
    ROKS T
    &ACTIVE_SPACE
      ACTIVE_ELECTRONS 4
      ACTIVE_ORBITALS 4
      AS_SOLVER NONE
      ORBITAL_SELECTION CANONICAL
      &ERI
        METHOD FULL_GPW
        PERIODICITY 0 0 0
      &END ERI
      &FCIDUMP
        FILENAME __STD_OUT__
      &END FCIDUMP
    &END ACTIVE_SPACE
    &MGRID
      CUTOFF 300
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 4
      EPS_SCF 1.0E-8
      MAX_SCF 100
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.3
        METHOD DIRECT_P_MIXING
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &HF 1.0
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      C 0.000  0.000  0.100
      H 0.000  0.990 -0.400
      H 0.000 -0.990 -0.400
    &END COORD
    &KIND C
      BASIS_SET 6-31G*
      POTENTIAL GTH-HF
    &END KIND
    &KIND H
      BASIS_SET 6-31G*
      POTENTIAL GTH-HF
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
