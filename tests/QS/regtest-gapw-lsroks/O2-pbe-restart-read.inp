! Frozen-orbital write/read regression: the shared ROKS orbitals must be preserved.
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT O2-pbe-restarted
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    ROKS
    WFN_RESTART_FILE_NAME O2-pbe-restart-RESTART.wfn
    &LOW_SPIN_ROKS
      ENERGY_SCALING -2 2
      SPIN_CONFIGURATION 1 1
      SPIN_CONFIGURATION 1 2
    &END LOW_SPIN_ROKS
    &MGRID
      CUTOFF 200
    &END MGRID
    &QS
      EPSFIT 1E-4
      EPS_DEFAULT 1E-10
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1E9
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 1
      SCF_GUESS RESTART
      &OT
        ENERGY_GAP 0.08
        MINIMIZER CG
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
        STEPSIZE 1E-8
      &END OT
      &PRINT
        &RESTART
          BACKUP_COPIES 0
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4 4 6
    &END CELL
    &COORD
      O 2 2 2.392
      O 2 2 3.608
    &END COORD
    &KIND O
      BASIS_SET 6-31G*
      LEBEDEV_GRID 110
      POTENTIAL ALL
      RADIAL_GRID 60
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
