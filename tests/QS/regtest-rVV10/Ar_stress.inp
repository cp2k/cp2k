&GLOBAL
  PRINT_LEVEL LOW
  PROJECT argon
  RUN_TYPE DEBUG
&END GLOBAL

&DEBUG
  DEBUG_FORCES F
  DEBUG_STRESS_TENSOR T
  DX 0.001
  EPS_NO_ERROR_CHECK 0.0001
  STOP_ON_MISMATCH T
&END DEBUG

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 160
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-10
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.0e-7
      MAX_SCF 50
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL NON_LOCAL
        &NON_LOCAL
          CUTOFF 150
          KERNEL_FILE_NAME rVV10_kernel_table.dat
          PARAMETERS 6.3 0.0093
          TYPE RVV10
          VERBOSE_OUTPUT F
        &END NON_LOCAL
      &END VDW_POTENTIAL
      &XC_FUNCTIONAL
        &GGA_C_PBE
        &END GGA_C_PBE
        &GGA_X_RPW86
        &END GGA_X_RPW86
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.31 5.31 5.31
      ALPHA_BETA_GAMMA 90 90 90
    &END CELL
    &COORD
      SCALED .TRUE.
      Ar 0.10 0.01 0.02
      Ar 0.50 0.51 0.00
      Ar 0.50 0.01 0.51
      Ar 0.02 0.51 0.50
    &END COORD
    &KIND Ar
      BASIS_SET DZVP-MOLOPT-SR-GTH-q8
      POTENTIAL GTH-PADE-q8
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
