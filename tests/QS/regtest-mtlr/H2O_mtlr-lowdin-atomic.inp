&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2O_mtlr_atomic
  RUN_TYPE MTLR
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    EPS_U_J_LOOP [eV] 0.01
    LSD
    MULTIPLICITY 1
    PLUS_U_METHOD LOWDIN
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 200
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
      EXTRAPOLATION USE_GUESS
    &END QS
    &SCF
      EPS_SCF 1.0E-5
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &OT OFF
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.0 4.0 4.0
    &END CELL
    &COORD
      O  0.000   0.000   -0.111
      H  0.000  -0.744    0.495
      H  0.000   0.744    0.495
    &END COORD
    &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PADE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PADE-q6
      &DFT_PLUS_U
        J [eV] 0.001
        L 1
        U_MINUS_J [eV] 0.08
        &MINIMUM_TRACKING_LINEAR_RESPONSE ON
          INDEX_PERTURBED_ATOM 1
          PERTURBATION_STRENGTH [eV] -0.20 -0.10 0.00 0.10 0.20
        &END MINIMUM_TRACKING_LINEAR_RESPONSE
      &END DFT_PLUS_U
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
