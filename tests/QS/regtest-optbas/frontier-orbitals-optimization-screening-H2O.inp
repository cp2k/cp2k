&GLOBAL
  PRINT_LEVEL MEDIUM
  PROGRAM_NAME OPTIMIZE_BASIS
  PROJECT frontier-orbitals-optimization-screening-H2O
&END GLOBAL

&OPTIMIZE_BASIS
  BASIS_OUTPUT_FILE BASIS_OUTPUT
  BASIS_TEMPLATE_FILE BASIS_GTH_MOLOPT_AUG_H2O
  &FIT_KIND H
    BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
    INITIAL_DEGREES_OF_FREEDOM NONE
  &END FIT_KIND
  &FIT_KIND O
    BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
    INITIAL_DEGREES_OF_FREEDOM NONE
    ! Optimize only the three tier-2 augmentation contractions.
    ! The inherited SZV s and p contractions remain fixed.
    SWITCH_CONTRACTION_STATE 1 0 2
    SWITCH_CONTRACTION_STATE 1 1 2
    SWITCH_CONTRACTION_STATE 1 2 1
  &END FIT_KIND
  &FRONTIER_ORBITAL_SCREENING
    ! Restrict the number of optimizations to 1 to save computation time.
    ! Remove the following line to execute all 5 optimizations.
    NUMBER_OF_OPTIMIZATIONS 1
  &END FRONTIER_ORBITAL_SCREENING
  &OPTIMIZATION
    ! Recommended for production molecular optimizations:
    ! ACCURACY 1.0E-5 (default value)
    ! MAX_FUN 800
    ! STEP_SIZE 0.05
    ! MAX_FUN is reduced below to keep this regression test inexpensive.
    ACCURACY 1.0E-5
    MAX_FUN 100
    STEP_SIZE 0.05
  &END OPTIMIZATION
&END OPTIMIZE_BASIS

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_GTH_MOLOPT_AUG_H2O
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 100
      NGRIDS 5
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
    &PRINT
      &HIRSHFELD OFF
      &END HIRSHFELD
      &MULLIKEN OFF
      &END MULLIKEN
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-10
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-7
      MAX_SCF 100
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.0 5.0 5.0
      PERIODIC NONE
    &END CELL
    &COORD
      O  0.000000  0.000000 -0.065587
      H  0.000000 -0.757136  0.520545
      H  0.000000  0.757136  0.520545
    &END COORD
    &KIND H
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
