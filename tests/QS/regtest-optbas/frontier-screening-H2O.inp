&GLOBAL
  PRINT_LEVEL MEDIUM
  PROGRAM_NAME OPTIMIZE_BASIS
  PROJECT frontier-screening-H2O
&END GLOBAL

&OPTIMIZE_BASIS
  BASIS_OUTPUT_FILE BASIS_OPTIMIZED
  BASIS_TEMPLATE_FILE BASIS_MOLOPT
  &FIT_KIND H
    BASIS_SET DZVP-MOLOPT-GTH
    INITIAL_DEGREES_OF_FREEDOM COEFFICIENTS
  &END FIT_KIND
  &FIT_KIND O
    BASIS_SET DZVP-MOLOPT-GTH
    INITIAL_DEGREES_OF_FREEDOM COEFFICIENTS
  &END FIT_KIND
  &FRONTIER_ORBITAL_SCREENING
  &END FRONTIER_ORBITAL_SCREENING
  &OPTIMIZATION
    ACCURACY 1.0E-5
    MAX_FUN 10
    STEP_SIZE 0.05
  &END OPTIMIZATION
&END OPTIMIZE_BASIS

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 200
    &END MGRID
    &PRINT
      &HIRSHFELD OFF
      &END HIRSHFELD
      &MULLIKEN OFF
      &END MULLIKEN
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      ADDED_MOS 5
      EPS_SCF 1.0E-7
      MAX_SCF 40
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
      PERIODIC NONE
    &END CELL
    &COORD
      O  0.000000  0.000000 -0.065587
      H  0.000000 -0.757136  0.520545
      H  0.000000  0.757136  0.520545
    &END COORD
    &KIND H
      BASIS_SET TZV2P-MOLOPT-GTH
      POTENTIAL GTH-PADE-q1
    &END KIND
    &KIND O
      BASIS_SET TZV2P-MOLOPT-GTH
      POTENTIAL GTH-PADE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
