#CPQA DEPENDS frontier-screening-H2O-ref.inp
&GLOBAL
  PROGRAM_NAME OPTIMIZE_BASIS
  PROJECT frontier-screening-H2O
  PRINT_LEVEL MEDIUM
&END GLOBAL

&OPTIMIZE_BASIS
  BASIS_TEMPLATE_FILE BASIS_MOLOPT
  BASIS_WORK_FILE frontier-screening-H2O-work.basis
  BASIS_OUTPUT_FILE frontier-screening-H2O-ranked.basis
  WRITE_FREQUENCY 1000
  USE_CONDITION_NUMBER

  &FIT_KIND H
    BASIS_SET DZVP-MOLOPT-GTH
    INITIAL_DEGREES_OF_FREEDOM COEFFICIENTS
  &END FIT_KIND
  &FIT_KIND O
    BASIS_SET DZVP-MOLOPT-GTH
    INITIAL_DEGREES_OF_FREEDOM COEFFICIENTS
  &END FIT_KIND

  &FRONTIER_ORBITALS
    GAP_ENERGY_SCALE [eV] 1.0
    VIRTUAL_ENERGY_CUTOFF [eV] 3.0
    VIRTUAL_ENERGY_SMOOTHING [eV] 0.2
  &END FRONTIER_ORBITALS
  &FRONTIER_ORBITAL_SCREENING
    NUMBER_OF_OPTIMIZATIONS 2
  &END FRONTIER_ORBITAL_SCREENING

  &TRAINING_FILES
    INPUT_FILE_NAME frontier-screening-H2O-ref.inp
  &END TRAINING_FILES
  &OPTIMIZATION
    STEP_SIZE 0.05
    ACCURACY 1.0E-5
    MAX_FUN 8
  &END OPTIMIZATION
&END OPTIMIZE_BASIS
