# Created 28.08.2026 by Jan Wilhelm
#CPQA DEPENDS H2O-ref.inp
&GLOBAL
  PROGRAM_NAME OPTIMIZE_BASIS
  PROJECT frontier-H2O
&END GLOBAL

&OPTIMIZE_BASIS
  BASIS_OUTPUT_FILE frontier-H2O-optimized.basis
  BASIS_TEMPLATE_FILE BASIS_MOLOPT
  BASIS_WORK_FILE frontier-H2O-work.basis
  &FIT_KIND H
    BASIS_SET DZVP-MOLOPT-GTH
    INITIAL_DEGREES_OF_FREEDOM COEFFICIENTS
  &END FIT_KIND
  &FIT_KIND O
    BASIS_SET DZVP-MOLOPT-GTH
    INITIAL_DEGREES_OF_FREEDOM COEFFICIENTS
  &END FIT_KIND
  &FRONTIER_ORBITALS
    GAP_ENERGY_SCALE [eV] 1.0
    VIRTUAL_ENERGY_CUTOFF [eV] 3.0
    VIRTUAL_ENERGY_SMOOTHING [eV] 0.2
  &END FRONTIER_ORBITALS
  &OPTIMIZATION
    ACCURACY 1.0E-5
    MAX_FUN 1
    STEP_SIZE 0.05
  &END OPTIMIZATION
  &TRAINING_FILES
    INPUT_FILE_NAME H2O-ref.inp
  &END TRAINING_FILES
&END OPTIMIZE_BASIS
