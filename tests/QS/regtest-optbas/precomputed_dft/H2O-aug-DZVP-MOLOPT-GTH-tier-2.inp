&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2O-aug-DZVP-MOLOPT-GTH-tier-2-reference
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME ../BASIS_GTH_MOLOPT_AUG_H2O
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      NGRIDS 5
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
    &PRINT
      &HIRSHFELD OFF
      &END HIRSHFELD
      &MULLIKEN OFF
      &END MULLIKEN
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-10
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-7
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
      PERIODIC NONE
    &END CELL
    &COORD
      O  0.000000  0.000000 -0.065587
      H  0.000000 -0.757136  0.520545
      H  0.000000  0.757136  0.520545
    &END COORD
    &KIND H
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
