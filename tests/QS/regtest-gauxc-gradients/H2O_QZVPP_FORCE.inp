! Keep oxygen g functions; use a compact grid/cell and SVP hydrogen for CI.
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME H2O_QZVPP_FORCE
  RUN_TYPE DEBUG
&END GLOBAL

&DEBUG
  ! Displace the oxygen center carrying the g functions, along a nonzero-force direction.
  CHECK_ATOM_FORCE 1 z
  DEBUG_FORCES T
  DEBUG_STRESS_TENSOR F
  DX 1.0E-4
  EPS_NO_ERROR_CHECK 5.0E-5
  STOP_ON_MISMATCH T
&END DEBUG

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION USE_PREV_P
      GAPW_ACCURATE_XCINT T
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.0E-9
      MAX_SCF 80
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          GRID GM3
          ! Explicit model file: MODEL PBE equals the default FUNCTIONAL and bypasses OneDFT.
          MODEL pbe.fun
          MODEL_GRADIENT_RUNTIME AUTO
          PRUNING_SCHEME ROBUST
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      O 3.00000000 3.00000000 3.00000000
      H 3.00000000 3.75695000 3.58588000
      H 3.00000000 2.24305000 3.58588000
    &END COORD
    &KIND H
      BASIS_SET SVP-MOLOPT-PBE-ae
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET QZVPP-MOLOPT-PBE-ae
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
