! Three OT steps deliberately test energy and orbital-derivative updates.
! This is a regression trajectory, not a converged molecular reference.
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT O2-tpssh
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    ROKS
    &LOW_SPIN_ROKS
      ENERGY_SCALING -2 2
      SPIN_CONFIGURATION 1 1
      SPIN_CONFIGURATION 1 2
    &END LOW_SPIN_ROKS
    &MGRID
      CUTOFF 200
    &END MGRID
    &QS
      EPSFIT 1E-4
      EPS_DEFAULT 1E-10
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1E-8
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 3
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
    &END SCF
    &XC
      &HF
        FRACTION 0.1
        &MEMORY
          MAX_MEMORY 128
        &END MEMORY
        &SCREENING
          EPS_SCHWARZ 1E-12
        &END SCREENING
      &END HF
      &XC_FUNCTIONAL
        &MGGA_C_TPSS
        &END MGGA_C_TPSS
        &MGGA_X_TPSS
          SCALE 0.9
        &END MGGA_X_TPSS
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4 4 6
    &END CELL
    &COORD
      O 2 2 2.392
      O 2 2 3.608
    &END COORD
    &KIND O
      BASIS_SET 6-31G*
      LEBEDEV_GRID 110
      POTENTIAL ALL
      RADIAL_GRID 60
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
