&GLOBAL
  PRINT_LEVEL LOW
  PROJECT MnO2
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    CHARGE 0
    MULTIPLICITY 4
    PLUS_U_METHOD MULLIKEN
    POTENTIAL_FILE_NAME POTENTIAL
    UKS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 5.0E-8
    &END QS
    &SCF
      EPS_SCF 1.0E-05
      MAX_SCF 60
      &DIAGONALIZATION
        ALGORITHM STANDARD
        UPDATE_METHOD ADIIS
      &END DIAGONALIZATION
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 2.85657818 0.00000000 0.00000000
      B -1.42828909 2.47386927 0.00000000
      C 0.00000000 0.00000000 4.60137406
      PERIODIC XYZ
    &END CELL
    &COORD
      Mn          2.85657818    0.00000000    2.30068703
      O           1.42828910    0.82462308    1.35145775
      O          -0.00000001    1.64924619    3.24991631
    &END COORD
    &KIND O
      BASIS_SET SZV-MOLOPT-SR-GTH-q6
      ELEMENT O
      POTENTIAL GTH-PBE
    &END KIND
    &KIND Mn
      BASIS_SET SZV-MOLOPT-SR-GTH-q15
      ELEMENT Mn
      MAGNETIZATION 3.00
      POTENTIAL GTH-PBE
      &DFT_PLUS_U
        L 2
        U_MINUS_J [eV] 3.5
      &END DFT_PLUS_U
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
