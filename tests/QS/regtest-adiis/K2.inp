&GLOBAL
  PRINT_LEVEL LOW
  PROJECT K2
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    UKS
    &MGRID
      CUTOFF 200
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      EPS_SCF 5.0E-6
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 60
      SCF_GUESS atomic
      &DIAGONALIZATION
        ALGORITHM STANDARD
        UPDATE_METHOD ADIIS
      &END DIAGONALIZATION
      &PRINT
        &RESTART off
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 6.0 6.0
    &END CELL
    &COORD
      K     0.000000  0.000000  0.000000
      K     3.000000  0.000000  0.000000
    &END COORD
    &KIND K
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
