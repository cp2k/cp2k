! Three OT steps deliberately test energy and orbital-derivative updates.
! This is a regression trajectory, not a converged molecular reference.
&GLOBAL
  PROJECT O2-skala-spinflip
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    ROKS
    MULTIPLICITY 3
    &LOW_SPIN_ROKS
      ENERGY_SCALING -2 2
      SPIN_CONFIGURATION 2 2
      SPIN_CONFIGURATION 2 1
    &END LOW_SPIN_ROKS
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1E-10
      EPSFIT 1E-4
    &END QS
    &MGRID
      CUTOFF 200
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1E-8
      MAX_SCF 3
      IGNORE_CONVERGENCE_FAILURE
      &OT
        ROTATION
        MINIMIZER CG
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          MODEL SKALA
          GRID FINE
          PRUNING_SCHEME UNPRUNED
          INT_EXECUTION_SPACE HOST
          SKALA_RUNTIME SELF
          MODEL_ATOM_CHUNK_SIZE 1
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4 4 6
      PERIODIC NONE
    &END CELL
    &COORD
      O 2 2 2.392
      O 2 2 3.608
    &END COORD
    &KIND O
      BASIS_SET 6-31G*
      POTENTIAL ALL
      RADIAL_GRID 60
      LEBEDEV_GRID 110
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
