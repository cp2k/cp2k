# CAS(4,6) of water, CANONICAL selection (MOs 3-8); also writes the active-space Molden file
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT h2o_canonical
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    &ACTIVE_SPACE
      ACTIVE_ELECTRONS 4
      ACTIVE_ORBITALS 6
      ORBITAL_SELECTION CANONICAL
      &ERI
        METHOD FULL_GPW
        PERIODICITY 0 0 0
      &END ERI
      &ERI_GPW
        CUTOFF 400
      &END ERI_GPW
      &FCIDUMP
        FILENAME __STD_OUT__
      &END FCIDUMP
      &MOLDEN
        FILENAME =h2o_canonical_as.molden
      &END MOLDEN
    &END ACTIVE_SPACE
    &MGRID
      CUTOFF 400
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 6
      EPS_SCF 1.0E-8
      MAX_SCF 50
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &HF 1.0
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      O 0.000  0.000  0.117
      H 0.000  0.757 -0.469
      H 0.000 -0.757 -0.469
    &END COORD
    &KIND H
      BASIS_SET 6-31G*
      POTENTIAL GTH-HF
    &END KIND
    &KIND O
      BASIS_SET 6-31G*
      POTENTIAL GTH-HF
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
