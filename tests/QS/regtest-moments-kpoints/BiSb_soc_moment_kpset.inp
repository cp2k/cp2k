&GLOBAL
  PRINT_LEVEL low
  PROJECT BiSb_soc_moment_kpset
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &KPOINTS
      FULL_GRID T
      SCHEME MONKHORST-PACK 4 4 1
    &END KPOINTS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &PRINT
      ! SOC spinor dipoles and Berry curvature, also written to the two extra files
      &MOMENTS
        BERRY_CURVATURE_FILE BiSb_soc_berry.dat
        KPOINT_DIPOLE_FILE BiSb_soc_kp_dipoles.dat
        MAX_NMO 4
        SOC T
        UNIT au_dip
        &KPOINT_SET
          NPOINTS 1
          SPECIAL_POINT 0.2 0.1 0.0
        &END KPOINT_SET
      &END MOMENTS
    &END PRINT
    &QS
      METHOD gpw
    &END QS
    &SCF
      ADDED_MOS 4
      EPS_SCF 1.0E-6
      MAX_SCF 100
      SCF_GUESS atomic
      &DIAGONALIZATION
        ALGORITHM STANDARD
        EPS_ADAPT 0.01
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        BETA 1.5
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR ON
        ELECTRONIC_TEMPERATURE [K] 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [angstrom] 4.23 4.23 20.0
      ALPHA_BETA_GAMMA 90. 90. 60.
      PERIODIC XYZ
    &END CELL
    ! buckled honeycomb BiSb monolayer (no inversion symmetry -> spin-split bands)
    &COORD
      SCALED
      Sb  1./3.  1./3.  0.0
      Bi  2./3.  2./3.  0.0825
    &END COORD
    &KIND Sb
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND Bi
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q5
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES T
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
