&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H2_USPP_GAPW
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    &MGRID
      CUTOFF 200
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-10
      FORCE_PAW TRUE
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.E-9
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &OT
        ENERGY_GAP 0.001
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC 4 4 4
    &END CELL
    &COORD
      H 1.1 1.2 1.3
      H 1.85 1.42 1.49
    &END COORD
    &KIND H
      BASIS_SET SZV-MOLOPT-SR-GTH-q1
      HARD_EXP_RADIUS 1.2
      LEBEDEV_GRID 50
      POTENTIAL UPF H.pbe-gbrv.UPF
      RADIAL_GRID 80
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
