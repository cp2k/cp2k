&GLOBAL
  PRINT_LEVEL LOW
  PROJECT aln_symmetry_metric
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &KPOINTS
      EPS_SYMMETRY 1.e-8
      GAMMA_CENTERED T
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY T
      SYMMETRY_BACKEND SPGLIB
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &PRINT
      &WANNIER90 ON
        KPOINTS_SOURCE SCF
        REUSE_SCF_MOS T
        SEED_NAME aln_symmetry_metric
        USE_BLOCH_PHASES T
        VALIDATE_REUSE_SCF_MOS T
        WANNIER_FUNCTIONS 8
      &END WANNIER90
    &END PRINT
    &QS
      EPS_DEFAULT 1.e-12
      METHOD GPW
    &END QS
    &SCF
      CHOLESKY OFF
      EPS_EIGVAL 1.e-12
      EPS_SCF 1.e-10
      MAX_SCF 200
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.3
        METHOD BROYDEN_MIXING
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 3.12 3.12 5.0
      ALPHA_BETA_GAMMA 90 90 120
    &END CELL
    &COORD
      SCALED
      Al 0.3333333333333333 0.6666666666666667 0.0
      Al 0.6666666666666667 0.3333333333333333 0.5
      N 0.3333333333333333 0.6666666666666667 0.38
      N 0.6666666666666667 0.3333333333333333 0.88
    &END COORD
    &KIND Al
      BASIS_SET TZV2P-MOLOPT-GGA-GTH-q3
      POTENTIAL GTH-GGA-q3
    &END KIND
    &KIND N
      BASIS_SET TZV2P-MOLOPT-GGA-GTH-q5
      POTENTIAL GTH-GGA-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
