&GLOBAL
  PRINT_LEVEL LOW
  PROJECT he_zmp
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &EXTERNAL_DENSITY
      FERMI_AMALDI TRUE
      FILE_DENSITY he_density.cube
      LAMBDA 1.0
      ZMP_CONSTRAINT COULOMB
    &END EXTERNAL_DENSITY
    &MGRID
      CUTOFF 50
      NGRIDS 1
    &END MGRID
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 30
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.2
        BETA 1.5
        METHOD BROYDEN_MIXING
        NBUFFER 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4 4 4
      PERIODIC XYZ
    &END CELL
    &COORD
      He 2 2 2
    &END COORD
    &KIND He
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
