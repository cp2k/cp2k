&GLOBAL
  PRINT_LEVEL LOW
  PROJECT he_cube_fit
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &HARRIS_METHOD ON
      DENSITY_SOURCE CUBE_FIT
      FILE_DENSITY he_density.cube
      FIT_EPS 4.0E-3
      FIT_MAX_ITER 5
    &END HARRIS_METHOD
    &MGRID
      CUTOFF 50
      NGRIDS 1
    &END MGRID
    &SCF
      SCF_GUESS NONE
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4 4 4
      PERIODIC XYZ
    &END CELL
    &COORD
      He 2 2 2
    &END COORD
    &KIND He
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
