&GLOBAL
  PRINT_LEVEL LOW
  PROJECT he_external_density_guess
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 50
      NGRIDS 1
    &END MGRID
    &SCF
      EPS_SCF 1.0E-7
      EXTERNAL_DENSITY_FILE_NAME he_density.cube
      MAX_SCF 30
      SCF_GUESS EXTERNAL_DENSITY
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4 4 4
      PERIODIC XYZ
    &END CELL
    &COORD
      He 2 2 2
    &END COORD
    &KIND He
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
