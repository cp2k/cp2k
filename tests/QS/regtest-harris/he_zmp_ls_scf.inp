&GLOBAL
  PRINT_LEVEL LOW
  PROJECT he_zmp_ls_scf
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &EXTERNAL_DENSITY
      FERMI_AMALDI TRUE
      FILE_DENSITY he_density.cube
      LAMBDA 1.0
      ZMP_CONSTRAINT COULOMB
    &END EXTERNAL_DENSITY
    &LS_SCF
      EPS_FILTER 1.0E-8
      EPS_SCF 1.0E-7
      MATRIX_CLUSTER_TYPE ATOMIC
      MAX_SCF 50
      MIXING_FRACTION 0.2
      PERFORM_MU_SCAN FALSE
      PURIFICATION_METHOD SIGN
      REPORT_ALL_SPARSITIES OFF
      SIGN_METHOD SUBMATRIX
      SIGN_SYMMETRIC TRUE
      SUBMATRIX_SIGN_METHOD DIRECT_MUADJ_LOWMEM
      S_PRECONDITIONER NONE
    &END LS_SCF
    &MGRID
      CUTOFF 50
      NGRIDS 1
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-10
      LS_SCF
    &END QS
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 50
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4 4 4
      PERIODIC XYZ
    &END CELL
    &COORD
      He 2 2 2
    &END COORD
    &KIND He
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
