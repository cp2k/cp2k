&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Al_kpoint_mermin_cell_opt
  RUN_TYPE CELL_OPT
&END GLOBAL

&MOTION
  &CELL_OPT
    KEEP_ANGLES TRUE
    MAX_ITER 1
    OPTIMIZER BFGS
    &BFGS
      TRUST_RADIUS 0.005
    &END BFGS
  &END CELL_OPT
  &PRINT
    &CELL OFF
    &END CELL
    &RESTART OFF
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
    &TRAJECTORY OFF
    &END TRAJECTORY
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 1 1
      SYMMETRY ON
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-9
      EXTRAPOLATION USE_PREV_P
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 160
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM STRICT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER DIIS
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 600
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 0.000 2.050 2.050
      B 2.050 0.000 2.050
      C 2.050 2.050 0.000
    &END CELL
    &COORD
      Al 0.000 0.000 0.000
    &END COORD
    &KIND Al
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
