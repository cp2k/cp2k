&DFT
  @IF ( ${BECKE_ACTIVE} == TRUE )
  @INCLUDE becke_qs_gapw.inc
  @ENDIF
  @IF ( ${BECKE_ACTIVE} == FALSE )
  &QS
    EPS_DEFAULT 1.0E-12
    EXTRAPOLATION ASPC
    EXTRAPOLATION_ORDER 3
    METHOD GAPW
  &END QS
  @ENDIF
  BASIS_SET_FILE_NAME EMSL_BASIS_SETS
  POTENTIAL_FILE_NAME POTENTIAL
  @IF ( ${RESTART_WFN} == TRUE )
  WFN_RESTART_FILE_NAME ${WFN_FILE}
  @ENDIF
  LSD
  CHARGE 0
  &MGRID
    CUTOFF 100
    NGRIDS 5
  &END MGRID
  &SCF
    @IF ( ${RESTART_WFN} == TRUE )
    SCF_GUESS RESTART
    @ENDIF
    @IF ( ${RESTART_WFN} == FALSE )
    SCF_GUESS ATOMIC
    @ENDIF
    EPS_SCF 1.0E-5
    CHOLESKY INVERSE_DBCSR
    MAX_SCF 20
    &OT ON
      ALGORITHM IRAC
      MINIMIZER DIIS
      PRECONDITIONER FULL_ALL
    &END OT
    &OUTER_SCF ON
      EPS_SCF 1.0E-5
      MAX_SCF 2
    &END OUTER_SCF
    &PRINT
      &RESTART
        BACKUP_COPIES 0
        COMMON_ITERATION_LEVELS 1
        FILENAME ./${PROJECT_NAME}
        &EACH
          JUST_ENERGY ${WRITE_WFN}
          QS_SCF 0
        &END EACH
      &END RESTART
      &RESTART_HISTORY OFF
      &END RESTART_HISTORY
    &END PRINT
  &END SCF
  &XC
    &XC_FUNCTIONAL PBE
    &END XC_FUNCTIONAL
    &XC_GRID
      XC_DERIV SPLINE2
      XC_SMOOTH_RHO NONE
    &END XC_GRID
  &END XC
  &PRINT
    &HIRSHFELD OFF
    &END HIRSHFELD
    &MULLIKEN OFF
    &END MULLIKEN
  &END PRINT
&END DFT

&PRINT
  &FORCES ON
  &END FORCES
&END PRINT
