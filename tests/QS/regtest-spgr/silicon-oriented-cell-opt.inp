&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME silicon-oriented-cell-opt
  RUN_TYPE CELL_OPT
&END GLOBAL

&MOTION
  &CELL_OPT
    EPS_SYMMETRY 1e-4
    KEEP_SPACE_GROUP T
    MAX_ITER 1
    OPTIMIZER BFGS
  &END CELL_OPT
&END MOTION

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
      &EWALD
        ALPHA 1.0
      &END EWALD
    &END POISSON
    &QS
      METHOD XTB
      &XTB
        CHECK_ATOMIC_CHARGES F
        DO_EWALD T
      &END XTB
    &END QS
    &SCF
      EPS_SCF 1.E-5
      MAX_SCF 10
      SCF_GUESS ATOMIC
      &OT T
        MINIMIZER CG
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF T
        EPS_SCF 1.E-5
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      A 3.865739 3.865739 0.000000
      B 0.000000 3.865739 3.865739
      C 3.865739 0.000000 3.865739
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      Si 0.00 0.00 0.00
      Si 0.25 0.25 0.25
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
