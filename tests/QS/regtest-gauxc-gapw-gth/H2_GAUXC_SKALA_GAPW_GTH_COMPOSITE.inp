&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME H2_GAUXC_SKALA_GAPW_GTH_COMPOSITE
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 80
      REL_CUTOFF 20
    &END MGRID
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
    &QS
      ALPHA0_HARD 10
      EPSFIT 1.0E-4
      EPSISO 1.0E-12
      EPSRHO0 1.0E-8
      EPSSVD 0.0
      EPS_DEFAULT 1.0E-8
      EPS_GVG 1.0E-6
      EPS_PGF_ORB 1.0E-6
      GAPW_ACCURATE_XCINT T
      LMAXN0 2
      LMAXN1 6
      METHOD GAPW
      QUADRATURE GC_LOG
    &END QS
    &SCF
      EPS_SCF 1.0E-5
      IGNORE_CONVERGENCE_FAILURE T
      MAX_SCF 1
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.4
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          GRID FINE
          MODEL SKALA
          NATIVE_GRID_DIAGNOSTICS T
          PRUNING_SCHEME ROBUST
          PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      H 3.0 3.0 2.6
      H 3.0 3.0 3.4
    &END COORD
    &KIND H
      BASIS_SET DZVP-GTH
      HARD_EXP_RADIUS 1.5117809071370015011
      LEBEDEV_GRID 50
      POTENTIAL GTH-PBE-q1
      RADIAL_GRID 50
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
