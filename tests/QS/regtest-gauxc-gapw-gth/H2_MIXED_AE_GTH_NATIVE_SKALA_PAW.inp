&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME H2_MIXED_AE_GTH_NATIVE_SKALA_PAW
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 80
      NGRIDS 4
      REL_CUTOFF 20
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-8
      GAPW_ACCURATE_XCINT T
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.0E-5
      IGNORE_CONVERGENCE_FAILURE T
      MAX_SCF 1
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_DIAGNOSTICS T
          NATIVE_GRID_LAYOUT ATOM_COMPOSITE
          PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC 4.0 4.0 4.0
      PERIODIC XYZ
    &END CELL
    &COORD
      H_AE 2.0 2.0 1.6
      H_PP 2.0 2.0 2.4
    &END COORD
    &KIND H_AE
      BASIS_SET DZVP-ALL
      ELEMENT H
      HARD_EXP_RADIUS 1.0
      LEBEDEV_GRID 14
      POTENTIAL ALL
      RADIAL_GRID 20
    &END KIND
    &KIND H_PP
      BASIS_SET DZVP-GTH
      ELEMENT H
      HARD_EXP_RADIUS 1.0
      LEBEDEV_GRID 14
      POTENTIAL GTH-PBE-q1
      RADIAL_GRID 20
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
