&GLOBAL
  PRINT_LEVEL LOW
  PROJECT rocksalt
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 400
    &END MGRID
    &PRINT
      &BADER ON
      &END BADER
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-11
    &END QS
    &SCF
      ADDED_MOS 4
      EPS_SCF 1.0E-8
      MAX_SCF 150
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.25
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.64 5.64 5.64
    &END CELL
    &COORD
      SCALED
      Na 0.0 0.0 0.0
      Na 0.0 0.5 0.5
      Na 0.5 0.0 0.5
      Na 0.5 0.5 0.0
      Cl 0.5 0.0 0.0
      Cl 0.5 0.5 0.5
      Cl 0.0 0.0 0.5
      Cl 0.0 0.5 0.0
    &END COORD
    &KIND Na
      BASIS_SET DZVP-GTH-q9
      POTENTIAL GTH-PBE-q9
    &END KIND
    &KIND Cl
      BASIS_SET DZVP-GTH-q7
      POTENTIAL GTH-PBE-q7
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
