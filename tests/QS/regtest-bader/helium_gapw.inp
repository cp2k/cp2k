&GLOBAL
  PRINT_LEVEL LOW
  PROJECT helium_gapw_bader
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME ALL_POTENTIALS
    &MGRID
      CUTOFF 300
    &END MGRID
    &PRINT
      &BADER ON
      &END BADER
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-11
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
    &END CELL
    &COORD
      He 0.0 4.0 4.0
      He 4.0 4.0 4.0
    &END COORD
    &KIND He
      BASIS_SET DZVP-ALL
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
