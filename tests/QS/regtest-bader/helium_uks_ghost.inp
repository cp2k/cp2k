&GLOBAL
  PRINT_LEVEL LOW
  PROJECT helium_uks_ghost_bader
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    CHARGE 1
    MULTIPLICITY 2
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS
    &MGRID
      CUTOFF 380
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &PRINT
      &BADER ON
        &BASIN_CUBE ON
          FILENAME =helium_uks_basins.cube
          STRIDE 2 2 2
        &END BASIN_CUBE
      &END BADER
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-11
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
      PERIODIC NONE
    &END CELL
    &COORD
      He 3.4 4.0 4.0
      He_ghost 4.0 4.0 4.0
      He 4.6 4.0 4.0
    &END COORD
    &KIND He
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q2
    &END KIND
    &KIND He_ghost
      BASIS_SET DZVP-GTH
      ELEMENT He
      GHOST
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
