&GLOBAL
  PROJECT frozen-density
  PRINT_LEVEL LOW
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    @IF ${SCF_K} == T
      &KPOINTS
        SCHEME GAMMA
        SYMMETRY F
        WAVEFUNCTIONS COMPLEX
      &END KPOINTS
    @ENDIF
    &QS
      METHOD ${QS_METHOD}
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      EPS_PPNL 1.0E-14
    &END QS
    &MGRID
      CUTOFF 300
      NGRIDS 4
    &END MGRID
    &SCF
      EPS_SCF 1.0E-11
      MAX_SCF 100
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL ${FUNCTIONAL}
      &END XC_FUNCTIONAL
      &XC_GRID
        USE_FINER_GRID F
        XC_DERIV PW
      &END XC_GRID
    &END XC
    &PRINT
      &BAND_STRUCTURE
        ADDED_MOS 10
        &KPOINT_SET
          SPECIAL_POINT 0.0 0.0 0.0
          SPECIAL_POINT 0.0 0.0 0.0
          NPOINTS 1
        &END KPOINT_SET
      &END BAND_STRUCTURE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 5 5 5
      PERIODIC XYZ
    &END CELL
    &COORD
      He 2.0 2.0 2.0
      He 2.9 2.1 2.2
    &END COORD
    &KIND He
      BASIS_SET TZVP-MOLOPT-GGA-GTH-q2
      POTENTIAL GTH-PBE-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
