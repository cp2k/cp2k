&GLOBAL
  PRINT_LEVEL LOW
  PROJECT h3_as_fci_uks
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    MULTIPLICITY 2
    UKS TRUE
    &ACTIVE_SPACE
      ACTIVE_ELECTRONS 3
      ACTIVE_ORBITALS 4
      ACTIVE_ORBITAL_INDICES 1 2 3 4 1 2 3 4
      AS_SOLVER FCI
      EPS_FCI 1E-18
      EPS_ITER 1E-8
      MAX_ITER 5
      ORBITAL_SELECTION MANUAL
      SCF_EMBEDDING T
      &ERI
        EPS_INTEGRAL 1E-10
        METHOD FULL_GPW
        OPERATOR COULOMB
        PERIODICITY 0 0 0
      &END ERI
      &ERI_GPW
        CUTOFF 500
      &END ERI_GPW
      &MIXING
        ALPHA 1.0
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END ACTIVE_SPACE
    &MGRID
      CUTOFF 500
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      METHOD GAPW
    &END QS
    &SCF
      ADDED_MOS 4
      EPS_DIIS 1E-003
      EPS_EIGVAL 1E-009
      EPS_SCF 1E-011
      MAX_SCF 100
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &HF
        FRACTION 1.0
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      H 0.0 0.0 0.0
      H 0.0 0.0 0.8
      H 0.9 0.0 0.2
    &END COORD
    &KIND H
      BASIS_SET 6-31G*
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
