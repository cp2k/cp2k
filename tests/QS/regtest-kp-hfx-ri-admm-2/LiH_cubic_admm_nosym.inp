&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT LiH_cubic_admm_nosym
  RUN_TYPE ENERGY_FORCE
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    AUTO_BASIS RI_HFX SMALL
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_ADMM_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    SORT_BASIS EXP
    &AUXILIARY_DENSITY_MATRIX_METHOD
      ADMM_PURIFICATION_METHOD NONE
      EXCH_CORRECTION_FUNC NONE
    &END AUXILIARY_DENSITY_MATRIX_METHOD
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      FULL_GRID ON
      WAVEFUNCTIONS COMPLEX
      VERBOSE T
    &END KPOINTS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
    &END MGRID
    &QS
      EPS_PGF_ORB 1.0E-5
      EXTRAPOLATION USE_GUESS
      METHOD GPW
      PW_GRID_BLOCKED FALSE
    &END QS
    &SCF
      EPS_SCF 1.0E-7
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 200
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.15
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &HF
        FRACTION 1.0
        &INTERACTION_POTENTIAL
          CUTOFF_RADIUS 2.0
          POTENTIAL_TYPE TRUNCATED
        &END INTERACTION_POTENTIAL
        &RI
          EPS_PGF_ORB 1.0E-5
          MEMORY_CUT 2
          NGROUPS 2
          RI_METRIC IDENTITY
        &END RI
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.1 4.1 4.1
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &COORD
      SCALED
      Li  0.00000000  0.00000000  0.00000000
      H   0.50000000  0.50000000  0.50000000
    &END COORD
    &KIND Li
      BASIS_SET ccGRB-D-q3
      BASIS_SET AUX_FIT admm-dz-q3
      POTENTIAL GTH-HYB-q3
    &END KIND
    &KIND H
      BASIS_SET ccGRB-D-q1
      BASIS_SET AUX_FIT admm-dz-q1
      POTENTIAL GTH-HYB-q1
    &END KIND
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END TOPOLOGY
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR
      COMPONENTS
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
