&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H2_admm_kpsym
  RUN_TYPE ENERGY_FORCE
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    AUTO_BASIS RI_HFX SMALL
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_ADMM_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    SORT_BASIS EXP
    &AUXILIARY_DENSITY_MATRIX_METHOD
      ADMM_PURIFICATION_METHOD NONE
      EXCH_CORRECTION_FUNC NONE
    &END AUXILIARY_DENSITY_MATRIX_METHOD
    &KPOINTS
      ! Periodic H2 cell from cp2k-kpoint-data/advanced/tddfpt/h2_sym.inp.
      ! The 2x2x2 mesh reduces 8 -> 1 by the crystal point group; time reversal
      ! alone would leave 4.
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      WAVEFUNCTIONS COMPLEX
      VERBOSE T
    &END KPOINTS
    &MGRID
      CUTOFF 150
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_PGF_ORB 1.0E-5
      EXTRAPOLATION USE_GUESS
      METHOD GPW
      PW_GRID_BLOCKED FALSE
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.15
        METHOD BROYDEN_MIXING
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &HF
        FRACTION 1.0
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE IDENTITY
        &END INTERACTION_POTENTIAL
        &RI
          EPS_PGF_ORB 1.0E-5
          MEMORY_CUT 2
          NGROUPS 2
          RI_METRIC IDENTITY
        &END RI
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      H 0.441667 0.5 0.5
      H 0.558333 0.5 0.5
    &END COORD
    &KIND H
      BASIS_SET ccGRB-D-q1
      BASIS_SET AUX_FIT admm-dz-q1
      POTENTIAL GTH-HYB-q1
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR
      COMPONENTS
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
