&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2_admm2_orbital_aux_fit_kpsym
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    AUTO_BASIS RI_HFX SMALL
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_ADMM_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    SORT_BASIS EXP
    ! ADMM2 with AUX_FIT equal to the orbital basis must give the HF energy, stress and forces
    ! without ADMM: -0.54657036 Ha, 1/3 trace of the stress 1.8808787E+04 bar, force on atom 1
    ! -0.20471475 a.u. With EPS_PGF_ORB 1.0E-8 the k-point neighbor list is larger than the 2x2x2
    ! Born-von Karman supercell, so the folded ADMM exchange correction needs Wigner-Seitz weights.
    &AUXILIARY_DENSITY_MATRIX_METHOD
      ADMM_PURIFICATION_METHOD NONE
      EXCH_CORRECTION_FUNC NONE
    &END AUXILIARY_DENSITY_MATRIX_METHOD
    &KPOINTS
      ! Periodic H2 cell from cp2k-kpoint-data/advanced/tddfpt/h2_sym.inp.
      ! The 2x2x2 mesh reduces 8 -> 1 by the crystal point group; time reversal
      ! alone would leave 4.
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      VERBOSE T
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 150
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_PGF_ORB 1.0E-8
      EXTRAPOLATION USE_GUESS
      METHOD GPW
      PW_GRID_BLOCKED FALSE
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.15
        METHOD BROYDEN_MIXING
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &HF
        FRACTION 1.0
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE IDENTITY
        &END INTERACTION_POTENTIAL
        &RI
          EPS_PGF_ORB 1.0E-8
          MEMORY_CUT 2
          NGROUPS 2
          RI_METRIC IDENTITY
        &END RI
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR
      COMPONENTS
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      H 0.441667 0.5 0.5
      H 0.558333 0.5 0.5
    &END COORD
    &KIND H
      BASIS_SET ccGRB-D-q1
      BASIS_SET AUX_FIT ccGRB-D-q1
      POTENTIAL GTH-HYB-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
