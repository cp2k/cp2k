&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT AlAs_admm_kpsym
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    AUTO_BASIS RI_HFX SMALL
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_ADMM_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    SORT_BASIS EXP
    WFN_RESTART_FILE_NAME AlAs_pbe-RESTART.kp
    &AUXILIARY_DENSITY_MATRIX_METHOD
      ADMM_PURIFICATION_METHOD NONE
      EXCH_CORRECTION_FUNC NONE
    &END AUXILIARY_DENSITY_MATRIX_METHOD
    &KPOINTS
      ! AlAs zincblende: the 2x2x2 mesh reduces 8 -> 2 by the crystal
      ! point group (F-43m). This exercises a genuine point-group operation
      ! in the ADMM density transform, unlike a time-reversal-only cell.
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      VERBOSE T
    &END KPOINTS
    &MGRID
      CUTOFF 150
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_PGF_ORB 1.0E-5
      EXTRAPOLATION USE_GUESS
      METHOD GPW
      PW_GRID_BLOCKED FALSE
    &END QS
    &SCF
      EPS_SCF 1.0E-5
      MAX_SCF 1
      IGNORE_CONVERGENCE_FAILURE
      SCF_GUESS RESTART
      &MIXING
        ALPHA 0.15
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &HF
        FRACTION 1.0
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE IDENTITY
        &END INTERACTION_POTENTIAL
        &RI
          EPS_PGF_ORB 1.0E-5
          MEMORY_CUT 2
          NGROUPS 2
          RI_METRIC IDENTITY
        &END RI
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 4.0133978007 4.0133978007 4.0133978007
      ALPHA_BETA_GAMMA 60.0 60.0 60.0
      MULTIPLE_UNIT_CELL 1 1 1
    &END CELL
    &COORD
      SCALED
      Al  0.00000000  0.00000000  0.00000000
      As  0.25000000  0.25000000  0.25000000
    &END COORD
    &KIND Al
      BASIS_SET ccGRB-D-q3
      BASIS_SET AUX_FIT admm-dz-q3
      POTENTIAL GTH-PBE0-q3
    &END KIND
    &KIND As
      BASIS_SET ccGRB-D-q5
      BASIS_SET AUX_FIT admm-dz-q5
      POTENTIAL GTH-PBE0-q5
    &END KIND
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
