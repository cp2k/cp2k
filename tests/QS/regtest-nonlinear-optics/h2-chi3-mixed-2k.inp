&GLOBAL
  PRINT_LEVEL LOW
  PROJECT h2-inversion
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &KPOINTS
      FULL_GRID ON
      SCHEME MONKHORST-PACK 1 1 1
    &END KPOINTS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      ADDED_MOS 10
      EPS_SCF 1.0E-8
      MAX_SCF 30
      &DIAGONALIZATION ON
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.3
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &NONLINEAR_OPTICS
      ELEMENTS ZZZZ
      FREQ_1 VALUE 1.0
      FREQ_2 MINUS_OF FREQ_1
      FREQ_3 VALUE 1.5
      K_MESH 2 1 1
      ORDER 3
    &END NONLINEAR_OPTICS
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 8 8 8
      PERIODIC XYZ
    &END CELL
    &COORD
      H 0 0 -0.37
      H 0 0 0.37
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
