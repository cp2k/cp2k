! Polar GeO molecular lattice in an 8 A periodic cell.
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT geo-scalar-chi5
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &KPOINTS
      FULL_GRID ON
      SCHEME MONKHORST-PACK 1 1 1
    &END KPOINTS
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      ADDED_MOS 10
      EPS_SCF 1.0E-8
      MAX_SCF 100
      &DIAGONALIZATION ON
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.3
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &NONLINEAR_OPTICS
      ELEMENTS ZZZZZZ
      FREQ_1 VALUE 1.0
      FREQ_2 SAME_AS FREQ_1
      FREQ_3 SAME_AS FREQ_1
      FREQ_4 SAME_AS FREQ_1
      FREQ_5 SAME_AS FREQ_1
      K_MESH 1 1 1
      ORDER 5
    &END NONLINEAR_OPTICS
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 8 8 8
      PERIODIC XYZ
    &END CELL
    &COORD
      Ge 0 0 -0.825
      O 0 0 0.825
    &END COORD
    &KIND Ge
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
