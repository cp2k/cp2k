@SET seed nacl_auto
@SET reuse T
@SET exclude 0
@SET disentangle F
@SET cation Na
@SET anion Cl
@SET q_cation 9
@SET half_a 2.82
@SET num_wann 8
@SET projections AUTO
# Bound unsuccessful AUTO starts; longer CG histories converge the useful trials.
@SET num_iter 4000
@SET num_cg_steps 20
@SET conv_tol 1.e-12
@INCLUDE ionic_common.inc