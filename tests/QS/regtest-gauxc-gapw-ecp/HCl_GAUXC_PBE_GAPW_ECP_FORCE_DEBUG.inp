&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME HCl_GAUXC_PBE_GAPW_ECP_FORCE_DEBUG
  RUN_TYPE DEBUG
&END GLOBAL

&DEBUG
  CHECK_ATOM_FORCE 2 z
  DEBUG_FORCES T
  DEBUG_STRESS_TENSOR F
  DX 1.0E-4
  EPS_NO_ERROR_CHECK 2.0E-5
  STOP_ON_MISMATCH T
&END DEBUG

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME ../regtest-ecp/ECP_BASIS_POT
    UKS FALSE
    &MGRID
      CUTOFF 300
      NGRIDS 5
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
      GAPW_ACCURATE_XCINT T
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 80
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          GRID FINE
          MODEL NONE
          PRUNING_SCHEME ROBUST
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      Cl 0.0 0.0 0.0
      H  0.0 0.0 1.3
    &END COORD
    &KIND Cl
      BASIS_SET DZVP-GTH-PADE
      GPW_TYPE
      POTENTIAL ECP ccECP
    &END KIND
    &KIND H
      BASIS_SET DZV-GTH-PADE
      GPW_TYPE
      POTENTIAL ECP ccECP
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
