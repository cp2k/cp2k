&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME H2-lattice-auto
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 80
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-9
    &END QS
    &SCF
      EPS_SCF 1.E-05
      MAX_SCF 30
      SCF_GUESS ATOMIC
      &OT T
        LATTICE_FFT AUTO
        LINESEARCH ADAPT
        MINIMIZER CG
        PRECONDITIONER FULL_KINETIC
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      MULTIPLE_UNIT_CELL 2 2 2
    &END CELL
    &COORD
      UNIT bohr
      H  0.0  0.0  0.0
      H  1.4  0.0  0.0
    &END COORD
    &KIND H
      BASIS_SET ORB SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 2 2 2
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
