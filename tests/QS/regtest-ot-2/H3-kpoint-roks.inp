&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H3_kpoint_roks
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    MULTIPLICITY 2
    POTENTIAL_FILE_NAME POTENTIAL
    ROKS
    &KPOINTS
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY OFF
    &END KPOINTS
    &MGRID
      CUTOFF 100
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 300
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM STRICT
        MINIMIZER CG
        PRECONDITIONER FULL_KINETIC
        ROTATION
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR
      COMPONENTS
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      H 0.0 0.0 0.0
      H 1.2 0.0 0.0
      H 0.3 1.1 0.0
    &END COORD
    &KIND H
      BASIS_SET SZV-GTH-PADE
      POTENTIAL GTH-PADE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
