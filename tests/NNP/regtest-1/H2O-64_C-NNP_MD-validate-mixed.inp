# Shadow-mode validation of the GPU code path against the CPU reference. On a
# build without GPU support, or a machine without a device, USE_GPU AUTO
# resolves to the CPU path and VALIDATE has no effect, so this input runs and
# passes on every architecture. On a GPU machine every force evaluation runs
# both code paths and aborts if they disagree.
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2O-64_C-NNP_MD-validate-mixed
  RUN_TYPE MD
&END GLOBAL

&MOTION
  &MD
    ENSEMBLE NVT
    STEPS 10
    TEMPERATURE 300
    TIMESTEP 0.5
    &PRINT
      FORCE_LAST
      &ENERGY
        &EACH
          MD 1
        &END EACH
      &END ENERGY
    &END PRINT
    &THERMOSTAT
      REGION GLOBAL
      TYPE CSVR
      &CSVR
        TIMECON 30.00
      &END CSVR
    &END THERMOSTAT
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 1
      &END EACH
    &END TRAJECTORY
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD NNP
  &NNP
    GPU_PRECISION MIXED
    NNP_INPUT_FILE_NAME NNP/bulkH2O-jcp2020-cnnp/nnp-1/input.nn
    SCALE_FILE_NAME NNP/bulkH2O-jcp2020-cnnp/nnp-1/scaling.data
    VALIDATE
    &MODEL
      WEIGHTS NNP/bulkH2O-jcp2020-cnnp/nnp-1/weights
    &END MODEL
    &MODEL
      WEIGHTS NNP/bulkH2O-jcp2020-cnnp/nnp-2/weights
    &END MODEL
    &MODEL
      WEIGHTS NNP/bulkH2O-jcp2020-cnnp/nnp-3/weights
    &END MODEL
    &MODEL
      WEIGHTS NNP/bulkH2O-jcp2020-cnnp/nnp-4/weights
    &END MODEL
    &MODEL
      WEIGHTS NNP/bulkH2O-jcp2020-cnnp/nnp-5/weights
    &END MODEL
    &MODEL
      WEIGHTS NNP/bulkH2O-jcp2020-cnnp/nnp-6/weights
    &END MODEL
    &MODEL
      WEIGHTS NNP/bulkH2O-jcp2020-cnnp/nnp-7/weights
    &END MODEL
    &MODEL
      WEIGHTS NNP/bulkH2O-jcp2020-cnnp/nnp-8/weights
    &END MODEL
    &PRINT
      &ENERGIES
        &EACH
          MD 1
        &END EACH
      &END ENERGIES
      &FORCES
        &EACH
          MD 1
        &END EACH
      &END FORCES
      &FORCES_SIGMA
        &EACH
          MD 1
        &END EACH
      &END FORCES_SIGMA
    &END PRINT
  &END NNP
  &SUBSYS
    &CELL
      ABC [angstrom] 12.42 12.42 12.42
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME ../coords/H2O-64.xyz
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
