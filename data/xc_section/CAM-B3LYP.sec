    # CP2K_SECTION_PATH: FORCE_EVAL/DFT
    # CAM-B3LYP functional:
    # T Yanai, DP Tew, NC Handy,
    # A new hybrid exchange–correlation functional using the
    # Coulomb-attenuating method, Chemical Physics Letters 393 (2004)
    #
    # CUTOFF_RADIUS should be smaller ~box length/2.
    #
    &XC
      &HF
        FRACTION 1.0
        &HF_INFO ON
        &END HF_INFO
        &INTERACTION_POTENTIAL
          CUTOFF_RADIUS 4.5
          OMEGA 0.33
          POTENTIAL_TYPE MIX_CL_TRUNC
          SCALE_COULOMB 0.19
          SCALE_LONGRANGE 0.46
          T_C_G_DATA t_c_g.dat
        &END INTERACTION_POTENTIAL
        &SCREENING
          EPS_SCHWARZ 1.0E-10
          SCREEN_ON_INITIAL_P FALSE
        &END SCREENING
      &END HF
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
        &PAIR_POTENTIAL
          CALCULATE_C9_TERM .FALSE.
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL CAMB3LYP
          TYPE DFTD3
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
      &XC_FUNCTIONAL
        &HYB_GGA_XC_CAM_B3LYP
          _AC 0.81
          _ALPHA 0.65
          _BETA -0.46
          _OMEGA 0.33
        &END HYB_GGA_XC_CAM_B3LYP
      &END XC_FUNCTIONAL
    &END XC
