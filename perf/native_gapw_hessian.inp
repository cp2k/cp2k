&GLOBAL
  PRINT_LEVEL LOW
  PROJECT perf_native_gapw_hessian
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS FALSE
    &MGRID
      CUTOFF 60
      REL_CUTOFF 15
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
      METHOD GAPW
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 400
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-8
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &SKALA_NATIVE
          ATOM_PARTITION HARD
          LAYOUT COMMON_GRID
          MODEL SKALA
          USE_GPU AUTO
          PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
        &END SKALA_NATIVE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &LINRES
      &POLAR
        PERIODIC_DIPOLE_OPERATOR F
      &END POLAR
    &END LINRES
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 7.913100 8.108020 6.099560
      PERIODIC XYZ
    &END CELL
    &COORD
       O     4.45070000     3.32550000     3.18694000
       H     5.41310000     3.25100000     3.18989000
       H     4.20060000     2.50000000     3.59956000
       O     3.22500000     5.60802000     2.50000000
       H     4.01250000     5.14208000     2.76064000
       H     2.50000000     5.28309000     2.98713000
    &END COORD
    &KIND O
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
