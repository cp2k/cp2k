&GLOBAL
  PROJECT perf_native_gapw_force
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS FALSE
    &MGRID
      CUTOFF 80
      REL_CUTOFF 20
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
      METHOD GAPW
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 200
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &SKALA_NATIVE
          ATOM_PARTITION SMOOTH
          MODEL SKALA
          USE_GPU AUTO
          PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
        &END SKALA_NATIVE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.42 12.42 12.42
      PERIODIC XYZ
    &END CELL
    &COORD
       O     5.43470000     2.47360000     4.30373000
       H     6.39710000     2.39910000     4.30668000
       H     5.18460000     1.64810000     4.71635000
       O     5.08473000    10.32813000    12.31980000
       H     5.79642000    10.97490000    12.13440000
       H     5.42957000     9.50102000    12.64560000
       O     4.02996000     7.60544000     8.73476000
       H     4.27003000     6.94768000     8.00554000
       H     4.77458000     8.28889000     8.74792000
       O     0.19350000     6.47220000    12.25860000
       H    -0.66640000     6.77600000    12.55890000
       H    -0.03140000     6.17980000    11.38190000
       O     1.36461000     4.68750000     3.65470000
       H     0.77220000     5.33188000     3.28890000
       H     0.92914100     4.08655000     4.31020000
       O     8.99811000     3.99641000     0.15220000
       H     9.94066000     4.05205000    -0.03330000
       H     8.84219000     4.18579000     1.07940000
       O    12.38190000     5.26919000     9.63980000
       H    13.16590000     4.62996000     9.68180000
       H    11.68550000     4.83976000     9.13352000
       O    11.96540000     1.80990000    10.97500000
       H    12.43150000     1.06810000    11.29410000
       H    12.66980000     2.50310000    10.79950000
    &END COORD
    &KIND O
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
