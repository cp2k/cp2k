   #! What this code must fill. At orders 1-2 CP2K already stores the entries
   #! that involve no gamma, so filling those again would double-count them.
   #! At order 3 it stores only the pure-density ones (the LDA path).
   #:set gam = lambda e: any('gamma' in d for d in e[0])
   #:set rho_only = lambda e: all(d in ('rhoa', 'rhob') for d in e[0])
   #:set gga_fill_1 = [e for e in gga_deriv_1 if gam(e)]
   #:set gga_fill_2 = [e for e in gga_deriv_2 if gam(e)]
   #:set gga_fill_3 = [e for e in gga_deriv_3 if not rho_only(e)]
   #:set mgga_fill_1 = [e for e in mgga_deriv_1 if gam(e)]
   #:set mgga_fill_2 = [e for e in mgga_deriv_2 if gam(e)]
   #:set mgga_fill_3 = [e for e in mgga_deriv_3 if not rho_only(e)]
   #:set rho3_entries = [e for e in gga_deriv_3 if rho_only(e)]

   #! third-derivative LibXC arrays the worker does not already carry
   #:set v3_have = ["v3rho3", "v3rho2sigma", "v3rhosigma2", "v3sigma3"]
   #:set v3_all = sorted(set(e[1] for e in mgga_deriv_3))
   #:set v3_new = [a for a in v3_all if a not in v3_have]

   #:set has_lap = lambda e: any('laplace' in d for d in e[0])
   #! Laplacian split for the spin-polarized meta-GGA lists, for the same
   #! reason as the restricted ones: requesting Laplacian entries for a
   #! functional that does not need them makes laplace_f true downstream.
   #:set mgga_fill_2_nl = [e for e in mgga_fill_2 if not has_lap(e)]
   #:set mgga_fill_2_l  = [e for e in mgga_fill_2 if has_lap(e)]
   #:set mgga_fill_3_nl = [e for e in mgga_fill_3 if not has_lap(e)]
   #:set mgga_fill_3_l  = [e for e in mgga_fill_3 if has_lap(e)]
   #:set mgga_all = mgga_fill_1 + mgga_fill_2 + mgga_fill_3

   #! kept for the already-validated GGA contraction
