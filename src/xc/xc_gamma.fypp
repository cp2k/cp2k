   #:set ugga_vars = ["rho", "gamma"]

   #:set umgga_deriv_1 = [(["rho"], "vrho", 1), (["gamma"], "vsigma", 1), (["laplace_rho"], "vlapl", 1), (["tau"], "vtau", 1)]
   #:set umgga_deriv_2 = [(["rho", "rho"], "v2rho2", 1), (["rho", "gamma"], "v2rhosigma", 1), (["rho", "laplace_rho"], "v2rholapl", 1), (["rho", "tau"], "v2rhotau", 1), (["gamma", "gamma"], "v2sigma2", 1), (["gamma", "laplace_rho"], "v2sigmalapl", 1), (["gamma", "tau"], "v2sigmatau", 1), (["laplace_rho", "laplace_rho"], "v2lapl2", 1), (["laplace_rho", "tau"], "v2lapltau", 1), (["tau", "tau"], "v2tau2", 1)]
   #:set umgga_deriv_3 = [(["rho", "rho", "rho"], "v3rho3", 1), (["rho", "rho", "gamma"], "v3rho2sigma", 1), (["rho", "rho", "laplace_rho"], "v3rho2lapl", 1), (["rho", "rho", "tau"], "v3rho2tau", 1), (["rho", "gamma", "gamma"], "v3rhosigma2", 1), (["rho", "gamma", "laplace_rho"], "v3rhosigmalapl", 1), (["rho", "gamma", "tau"], "v3rhosigmatau", 1), (["rho", "laplace_rho", "laplace_rho"], "v3rholapl2", 1), (["rho", "laplace_rho", "tau"], "v3rholapltau", 1), (["rho", "tau", "tau"], "v3rhotau2", 1), (["gamma", "gamma", "gamma"], "v3sigma3", 1), (["gamma", "gamma", "laplace_rho"], "v3sigma2lapl", 1), (["gamma", "gamma", "tau"], "v3sigma2tau", 1), (["gamma", "laplace_rho", "laplace_rho"], "v3sigmalapl2", 1), (["gamma", "laplace_rho", "tau"], "v3sigmalapltau", 1), (["gamma", "tau", "tau"], "v3sigmatau2", 1), (["laplace_rho", "laplace_rho", "laplace_rho"], "v3lapl3", 1), (["laplace_rho", "laplace_rho", "tau"], "v3lapl2tau", 1), (["laplace_rho", "tau", "tau"], "v3lapltau2", 1), (["tau", "tau", "tau"], "v3tau3", 1)]
   #:set umgga_vars = ["rho", "gamma", "laplace_rho", "tau"]

   #:set ugam = lambda e: 'gamma' in e[0]
