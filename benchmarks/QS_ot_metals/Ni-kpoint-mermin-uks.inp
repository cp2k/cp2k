&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Ni_kpoint_mermin_uks
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    UKS T
    &KPOINTS
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 3 2 1
      SYMMETRY OFF
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 100
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-9
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 240
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM STRICT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER LBFGS
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 1000
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 0.00 1.76 1.76
      B 1.76 0.00 1.76
      C 1.76 1.76 0.00
    &END CELL
    &COORD
      Ni 0.0 0.0 0.0
    &END COORD
    &KIND Ni
      BASIS_SET DZV-GTH-PADE-q10
      POTENTIAL GTH-PADE-q10
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
