&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Cu_kpoint_mermin_pbe
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 1 1
      SYMMETRY ON
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-5
      MAX_SCF 240
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM STRICT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER LBFGS
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 800
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 0.0000 1.8075 1.8075
      B 1.8075 0.0000 1.8075
      C 1.8075 1.8075 0.0000
    &END CELL
    &COORD
      Cu 0.0 0.0 0.0
    &END COORD
    &KIND Cu
      BASIS_SET DZV-GTH-PADE
      POTENTIAL GTH-PBE-q11
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
