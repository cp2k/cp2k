&GLOBAL
  PRINT_LEVEL LOW
  PROJECT MQAE
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QMMM
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    CHARGE 1
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      COMMENSURATE
      CUTOFF 400
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 300
      SCF_GUESS RESTART
      &OT T
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
        STEPSIZE 0.15
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &MM
    &FORCEFIELD
      DO_NONBONDED FALSE
    &END FORCEFIELD
    &POISSON
      &EWALD
        EWALD_TYPE NONE
      &END EWALD
    &END POISSON
  &END MM
  &QMMM
    ECOUPL GAUSS
    USE_GEEP_LIB 15
    &CELL
      ABC 13.79565 17.3825 10.76061
      PERIODIC XYZ
    &END CELL
    &PERIODIC
      &MULTIPOLE ON
      &END MULTIPOLE
    &END PERIODIC
    &QM_KIND H
      MM_INDEX 5 6 8 9 10 12 13 16 18 20 24 26 30 31 32 34
    &END QM_KIND
    &QM_KIND C
      MM_INDEX 2 4 7 11 15 17 19 21 22 23 25 27 29 33
    &END QM_KIND
    &QM_KIND N
      MM_INDEX 14
    &END QM_KIND
    &QM_KIND O
      MM_INDEX 1 3 28
    &END QM_KIND
  &END QMMM
  &SUBSYS
    &CELL
      A 41.751 0.000 0.000
      B 0.000 41.751 0.000
      C 0.000 0.000 41.751
      PERIODIC XYZ
    &END CELL
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT H
      POTENTIAL GTH-BLYP
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT C
      POTENTIAL GTH-BLYP
    &END KIND
    &KIND N
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT N
      POTENTIAL GTH-BLYP
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT O
      POTENTIAL GTH-BLYP
    &END KIND
    &KIND X
      ELEMENT H
    &END KIND
    &TOPOLOGY
      CHARGE_EXTENDED TRUE
      CONNECTIVITY OFF
      COORD_FILE_FORMAT PDB
      COORD_FILE_NAME mqae_cp2k.pdb
      &GENERATE
        &ISOLATED_ATOMS
          LIST 1..7186
        &END ISOLATED_ATOMS
      &END GENERATE
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
