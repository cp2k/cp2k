&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ClC_QM_19
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QMMM
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    CHARGE 1
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      COMMENSURATE
      CUTOFF 400
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 4
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 300
      SCF_GUESS RESTART
      &OT T
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
        STEPSIZE 0.15
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &MM
    &FORCEFIELD
      DO_NONBONDED FALSE
    &END FORCEFIELD
    &POISSON
      &EWALD
        EWALD_TYPE NONE
      &END EWALD
    &END POISSON
  &END MM
  &QMMM
    ECOUPL GAUSS
    USE_GEEP_LIB 15
    &CELL
      ABC 17.7 17.7 17.7
      PERIODIC XYZ
    &END CELL
    &LINK
      MM_INDEX 2878
      QM_INDEX 2880
    &END LINK
    &LINK
      MM_INDEX 2070
      QM_INDEX 2072
    &END LINK
    &PERIODIC
      GMAX 1.0E+00
      &MULTIPOLE ON
        EWALD_PRECISION 1.0E-06
        RCUT 1.0E+01
      &END MULTIPOLE
    &END PERIODIC
    &QM_KIND H
      MM_INDEX 2073 2074 2076 2077 2081 2881 2882 2884 2885
    &END QM_KIND
    &QM_KIND C
      MM_INDEX 2072 2075 2078 2880 2883 2886
    &END QM_KIND
    &QM_KIND O
      MM_INDEX 2079 2080 2887 2888
    &END QM_KIND
  &END QMMM
  &SUBSYS
    &CELL
      A 127.000 0.000 0.000
      B 0.000 127.000 0.000
      C 0.000 0.000 90.626
      PERIODIC XYZ
    &END CELL
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT H
      POTENTIAL GTH-BLYP
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT C
      POTENTIAL GTH-BLYP
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      ELEMENT O
      POTENTIAL GTH-BLYP
    &END KIND
    &KIND X
      ELEMENT H
    &END KIND
    &TOPOLOGY
      CHARGE_EXTENDED TRUE
      CONNECTIVITY OFF
      COORD_FILE_FORMAT PDB
      COORD_FILE_NAME ClC_cp2k.pdb
      &GENERATE
        &ISOLATED_ATOMS
          LIST 1..150925
        &END ISOLATED_ATOMS
      &END GENERATE
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
