&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ZnO
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    CHARGE 0
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      SCHEME MONKHORST-PACK 30 30 20
    &END KPOINTS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      EPS_SCF 1.0E-06
      MAX_SCF 128
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.4
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 3.23735102 0.00000000 0.00000000
      B -1.61867551 2.80362822 0.00000000
      C 0.00000000 0.00000000 5.22206130
      PERIODIC XYZ
    &END CELL
    &COORD
      Zn          1.61867553    0.93454273    2.61412054
      Zn         -0.00000002    1.86908549    0.00308989
      O           1.61867553    0.93454273    4.59394289
      O          -0.00000002    1.86908549    1.98291224
    &END COORD
    &KIND Zn
      BASIS_SET DZVP-MOLOPT-SR-GTH-q12
      ELEMENT Zn
      POTENTIAL GTH-PBE
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH-q6
      ELEMENT O
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
